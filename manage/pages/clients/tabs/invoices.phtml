<script>
document.addEventListener('DOMContentLoaded', function() {
  const invoiceTab = document.getElementById('tab_invoices');
  if (!invoiceTab) return;

  invoiceTab.addEventListener('show.bs.tab', function() {
    loadInvoices();
  });

  document.getElementById('btn_invoice_filter_toggle').addEventListener('click', function() {
    const panel = document.getElementById('invoice_filter_panel');
    panel.style.display = panel.style.display === 'none' ? 'grid' : 'none';
  });

  document.getElementById('btn_invoice_apply_filter').addEventListener('click', loadInvoices);
  document.getElementById('btn_invoice_reset_filter').addEventListener('click', function() {
    document.getElementById('invoice_filter_status').value = '';
    document.getElementById('invoice_filter_from').value = '';
    document.getElementById('invoice_filter_to').value = '';
    document.getElementById('invoice_filter_search').value = '';
    loadInvoices();
  });

  function loadInvoices(filters = {}) {
    const purchaseId = document.getElementById('ui_purchase_id')?.value;
    if (!purchaseId) return;

    fetch('/xhr/manage_inventory.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        action: 'get_invoices_list',
        purchase_id: purchaseId,
        status: document.getElementById('invoice_filter_status').value || '',
        from_date: document.getElementById('invoice_filter_from').value || '',
        to_date: document.getElementById('invoice_filter_to').value || '',
        search: document.getElementById('invoice_filter_search').value || ''
      })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        renderInvoices(data.invoices);
        updateInvoiceSummary(data.summary);
        loadOverpaymentCredits(data.credits);
      }
    })
    .catch(e => console.error('[v0] Error loading invoices:', e));
  }

  function renderInvoices(invoices) {
    const tbody = document.getElementById('invoices_tbody');
    tbody.innerHTML = '';
    document.getElementById('invoice_total_count').textContent = invoices.length;

    if (invoices.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-3">No invoices found</td></tr>';
      return;
    }

    invoices.forEach((inv, idx) => {
      const row = document.createElement('tr');
      const statusBadge = getInvoiceStatusBadge(inv.status);
      row.innerHTML = `
        <td>${idx + 1}</td>
        <td><strong>${inv.invoice_number}</strong></td>
        <td><span class="badge bg-secondary">${inv.invoice_type}</span></td>
        <td>${inv.invoice_date}</td>
        <td>${inv.due_date || '-'}</td>
        <td class="text-end">৳${parseFloat(inv.amount).toLocaleString('en-US', {maximumFractionDigits: 2})}</td>
        <td class="text-end text-success">৳${parseFloat(inv.paid_amount).toLocaleString('en-US', {maximumFractionDigits: 2})}</td>
        <td class="text-end">${inv.remaining_amount > 0 ? '৳' + parseFloat(inv.remaining_amount).toLocaleString('en-US', {maximumFractionDigits: 2}) : '<span class="text-success">Paid</span>'}</td>
        <td>${statusBadge}</td>
        <td>
          <button class="btn btn-sm btn-outline-primary" title="View" onclick="viewInvoice(${inv.id})">
            <i class="lni lni-eye"></i>
          </button>
          ${inv.status === 'draft' ? `<button class="btn btn-sm btn-outline-warning" title="Edit" onclick="editInvoice(${inv.id})"><i class="lni lni-pencil"></i></button>` : ''}
          ${['draft', 'issued', 'partial'].includes(inv.status) ? `<button class="btn btn-sm btn-outline-success" title="Record Payment" onclick="recordInvoicePayment(${inv.id})"><i class="lni lni-dollar"></i></button>` : ''}
        </td>
      `;
      tbody.appendChild(row);
    });
  }

  function updateInvoiceSummary(summary) {
    document.getElementById('inv_summary_total').textContent = parseFloat(summary.total_amount || 0).toLocaleString('en-US', {maximumFractionDigits: 2});
    document.getElementById('inv_summary_paid').textContent = parseFloat(summary.total_paid || 0).toLocaleString('en-US', {maximumFractionDigits: 2});
    document.getElementById('inv_summary_pending').textContent = summary.pending_count || 0;
    document.getElementById('inv_summary_overdue').textContent = summary.overdue_count || 0;
    document.getElementById('inv_summary_outstanding').textContent = parseFloat(summary.outstanding || 0).toLocaleString('en-US', {maximumFractionDigits: 2});
    document.getElementById('inv_summary_overpayment').textContent = parseFloat(summary.overpayment || 0).toLocaleString('en-US', {maximumFractionDigits: 2});
  }

  function loadOverpaymentCredits(credits) {
    const list = document.getElementById('overpayment_credits_list');
    list.innerHTML = '';
    
    if (!credits || credits.length === 0) {
      list.innerHTML = '<p class="text-muted text-center py-2">No overpayment credits</p>';
      return;
    }

    credits.forEach(credit => {
      const item = document.createElement('div');
      item.className = 'list-group-item';
      item.innerHTML = `
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-muted">Credit from Invoice #${credit.source_invoice}</small>
            <div>Remaining: <strong>৳${parseFloat(credit.remaining_amount).toLocaleString('en-US', {maximumFractionDigits: 2})}</strong></div>
          </div>
          <small class="text-muted">${credit.created_at}</small>
        </div>
      `;
      list.appendChild(item);
    });
  }

  function getInvoiceStatusBadge(status) {
    const badges = {
      'draft': '<span class="badge bg-secondary">Draft</span>',
      'issued': '<span class="badge bg-primary">Issued</span>',
      'partial': '<span class="badge bg-info">Partial</span>',
      'paid': '<span class="badge bg-success">Paid</span>',
      'cancelled': '<span class="badge bg-danger">Cancelled</span>'
    };
    return badges[status] || '<span class="badge bg-light">Unknown</span>';
  }
});

// Global functions
function viewInvoice(invoiceId) {
  console.log('[v0] Viewing invoice:', invoiceId);
}

function editInvoice(invoiceId) {
  console.log('[v0] Editing invoice:', invoiceId);
}

function recordInvoicePayment(invoiceId) {
  console.log('[v0] Recording payment for invoice:', invoiceId);
}
</script>
