<script>
jQuery(function($){
  // elements
  const $clientSel = $('#invoices_client_select');
  const $clientIdHidden = $('#invoices_client_id');
  const $purchaseSel = $('#invoices_purchase_select');

  const $filterStatus = $('#invoice_filter_status');
  const $filterFrom = $('#invoice_filter_from');
  const $filterTo = $('#invoice_filter_to');
  const $filterSearch = $('#invoice_filter_search');

  const $invoicesTbody = $('#invoices_tbody');
  const $invoiceTotalCount = $('#invoice_total_count');
  const $invSummaryTotal = $('#inv_summary_total');
  const $invSummaryPaid = $('#inv_summary_paid');
  const $invSummaryPending = $('#inv_summary_pending');
  const $invSummaryOverdue = $('#inv_summary_overdue');
  const $invSummaryOutstanding = $('#inv_summary_outstanding');
  const $invSummaryOverpayment = $('#inv_summary_overpayment');
  const $overpaymentCreditsList = $('#overpayment_credits_list');

  // debounce util
  function debounce(fn, ms) {
    let t = null;
    return function(...args) { clearTimeout(t); t = setTimeout(() => fn.apply(this, args), ms); };
  }

  function esc(s) { return String(s || '').replace(/[&<>"'\/]/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#x2F;'})[c]; }); }
  function formatMoney(v) { const n = parseFloat(v || 0); return n.toLocaleString('en-US', { maximumFractionDigits: 2, minimumFractionDigits: 2 }); }
  function invoiceStatusBadge(status) {
    const map = {
      'draft':'<span class="badge bg-secondary">Draft</span>',
      'issued':'<span class="badge bg-primary">Issued</span>',
      'partial':'<span class="badge bg-info text-dark">Partial</span>',
      'paid':'<span class="badge bg-success">Paid</span>',
      'cancelled':'<span class="badge bg-danger">Cancelled</span>'
    };
    return map[status] || ('<span class="badge bg-light text-dark">' + esc(status || 'Unknown') + '</span>');
  }

  // --- init client select2 (uses manage_clients search_clients) ---
  function initClientSelect2() {
    try { if ($clientSel.hasClass('select2-hidden-accessible')) $clientSel.select2('destroy'); } catch(e){}

    $clientSel.select2({
      placeholder: '-- Search client --',
      minimumInputLength: 1,
      width: '100%',
      ajax: {
        url: Wo_Ajax_Requests_File() + '?f=manage_clients&s=search_clients',
        type: 'POST',
        dataType: 'json',
        delay: 250,
        data: function(params) {
          return {
            q: params.term || '',
            include_purchase: 1,
            include_client_summary: 0,
            page: params.page || 1,
            per_page: 30
          };
        },
        processResults: function(data) {
          var rows = Array.isArray(data) ? data : (data.results && Array.isArray(data.results) ? data.results : []);
          return {
            results: rows.map(function(it){
              return { id: it.id, text: it.text || it.name || '', raw: it };
            })
          };
        }
      },
      templateResult: function(item){ return item && item.text ? $('<div>').text(item.text) : null; },
      templateSelection: function(item){ return item && item.text ? item.text : null; }
    });

    // On select populate purchases and load invoices (client-level)
    $clientSel.off('select2:select').on('select2:select', function(e){
      var item = e.params.data;
      var clientId = item ? item.id : '';
      $clientIdHidden.val(clientId);

      var purchases = (item.raw && item.raw.purchases) ? item.raw.purchases : [];
      $purchaseSel.prop('disabled', true).empty();
      if (purchases.length) {
        $purchaseSel.append('<option value="">-- Select Purchase --</option>');
        purchases.forEach(function(p){
          var val = p.purchase_id || p.id;
          var txt = p.file_num ? (p.file_num + ' (Booking ID: ' + p.booking_id + ')') : ('Purchase ' + val);
          $purchaseSel.append('<option value="'+val+'">'+txt+'</option>');
        });
        $purchaseSel.prop('disabled', false);
      } else {
        $purchaseSel.append('<option value="">-- No Purchases Found --</option>');
      }

      // load invoices for client (client-level)
      loadInvoices();
    });

    $clientSel.off('select2:clear').on('select2:clear', function(){
      $clientIdHidden.val('');
      $purchaseSel.prop('disabled', true).empty().append('<option value="">-- Select Purchase First --</option>');
      clearInvoicesPlaceholder();
    });
  }

  // Purchase change -> load invoices for purchase
  $purchaseSel.on('change', function(){ loadInvoices(); });

  // filters auto-apply
  [$filterStatus, $filterFrom, $filterTo].forEach(function($el){ $el.on('change', loadInvoices); });
  $filterSearch.on('input', debounce(loadInvoices, 400));

  $('#btn_invoice_apply_filter').on('click', loadInvoices);
  $('#btn_invoice_reset_filter').on('click', function(){
    $filterStatus.val('');
    $filterFrom.val('');
    $filterTo.val('');
    $filterSearch.val('');
    loadInvoices();
  });

  $('#btn_invoice_filter_toggle').on('click', function(){ $('#invoice_filter_panel').toggle(); });

  function clearInvoicesPlaceholder(){
    $invoicesTbody.html('<tr><td colspan="10" class="text-center text-muted py-3">Please select client or purchase to load invoices</td></tr>');
    $invoiceTotalCount.text('0');
    updateSummary({});
    $overpaymentCreditsList.html('<p class="text-muted text-center py-2">No overpayment credits</p>');
  }

  // Create Invoice button handler
  $('#btn_create_invoice_from_tab').on('click', function() {
    var purchaseId = $purchaseSel.val();
    var clientId = $clientIdHidden.val();
    var clientName = $clientSel.select2('data')[0].text;
    var fileNum = $purchaseSel.select2('data')[0].file_num;
    
    if (typeof openCreateInvoiceModal === 'function') {
      openCreateInvoiceModal(clientId, purchaseId, clientName, fileNum);
    } else {
      console.error('openCreateInvoiceModal function not found');
      alert('Invoice modal is not available. Please refresh the page.');
    }
  });

  // load invoices via $.ajax
  function loadInvoices() {
    const purchaseId = $purchaseSel.val() || '';
    const clientId = $clientIdHidden.val() || '';

    if (!purchaseId && !clientId) {
      clearInvoicesPlaceholder();
      return;
    }

    // build URL params (GET)
    const params = [];
    if (purchaseId) params.push('purchase_id=' + encodeURIComponent(purchaseId));
    else if (clientId) params.push('client_id=' + encodeURIComponent(clientId));

    if ($filterStatus.val()) params.push('status=' + encodeURIComponent($filterStatus.val()));
    if ($filterFrom.val()) params.push('from_date=' + encodeURIComponent($filterFrom.val()));
    if ($filterTo.val()) params.push('to_date=' + encodeURIComponent($filterTo.val()));
    if ($filterSearch.val()) params.push('search=' + encodeURIComponent($filterSearch.val()));

    $invoicesTbody.html('<tr><td colspan="10" class="text-center text-muted py-3">Loading invoices...</td></tr>');

    const url = Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_invoices' + (params.length ? '&' + params.join('&') : '');
    $.ajax({
      url: url,
      method: 'GET',
      dataType: 'json',
      success: function(data) {
        if (data && parseInt(data.status || 0) === 200) {
          renderInvoices(data.invoices || []);
          updateSummary(data.summary || {});
          renderCredits(data.credits || []);
        } else {
          $invoicesTbody.html('<tr><td colspan="10" class="text-center text-danger py-3">Failed to load invoices</td></tr>');
          updateSummary({});
          renderCredits([]);
        }
      },
      error: function(xhr, status, err) {
        console.error('loadInvoices error', status, err);
        $invoicesTbody.html('<tr><td colspan="10" class="text-center text-muted py-3">Error loading invoices</td></tr>');
        updateSummary({});
        renderCredits([]);
      }
    });
  }

  function renderInvoices(invoices) {
    $invoicesTbody.empty();
    $invoiceTotalCount.text(invoices.length || 0);

    if (!invoices || !invoices.length) {
      $invoicesTbody.html('<tr><td colspan="10" class="text-center text-muted py-3">No invoices found</td></tr>');
      return;
    }

    invoices.forEach(function(inv, idx){
      const remaining = parseFloat((inv.remaining_amount != null) ? inv.remaining_amount : ((inv.amount || 0) - (inv.paid_amount || 0)));
      const remainingHtml = remaining > 0 ? '৳' + formatMoney(remaining) : '<span class="text-success">Paid</span>';

      const $row = $('<tr/>').html(
        '<td>' + (idx + 1) + '</td>' +
        '<td><strong>' + esc(inv.invoice_number || '') + '</strong></td>' +
        '<td><span class="badge bg-secondary">' + esc(inv.invoice_type || '') + '</span></td>' +
        '<td>' + esc(inv.invoice_date || '') + '</td>' +
        '<td>' + (inv.due_date ? esc(inv.due_date) : '-') + '</td>' +
        '<td class="text-end">৳' + formatMoney(inv.amount || 0) + '</td>' +
        '<td class="text-end text-success">৳' + formatMoney(inv.paid_amount || 0) + '</td>' +
        '<td class="text-end">' + remainingHtml + '</td>' +
        '<td>' + invoiceStatusBadge(inv.status) + '</td>' +
        '<td>' +
          '<button class="btn btn-sm btn-outline-primary" title="View" onclick="viewInvoice(' + (inv.id) + ')"><i class="lni lni-eye"></i></button> ' +
          (inv.status === 'draft' ? '<button class="btn btn-sm btn-outline-warning" title="Edit" onclick="editInvoice(' + (inv.id) + ')"><i class="lni lni-pencil"></i></button> ' : '') +
          (['draft','issued','partial'].includes(inv.status) ? '<button class="btn btn-sm btn-outline-success" title="Record Payment" onclick="recordInvoicePayment(' + (inv.id) + ')"><i class="lni lni-dollar"></i></button>' : '') +
        '</td>'
      );
      $invoicesTbody.append($row);
    });
  }

  function updateSummary(s) {
    $invSummaryTotal.text(formatMoney(s.total_amount || 0));
    $invSummaryPaid.text(formatMoney(s.total_paid || 0));
    $invSummaryPending.text(s.pending_count || 0);
    $invSummaryOverdue.text(s.overdue_count || 0);
    $invSummaryOutstanding.text(formatMoney(s.outstanding || 0));
    $invSummaryOverpayment.text(formatMoney(s.overpayment || 0));
  }

  function renderCredits(credits) {
    $overpaymentCreditsList.empty();
    if (!credits || !credits.length) {
      $overpaymentCreditsList.html('<p class="text-muted text-center py-2">No overpayment credits</p>');
      return;
    }
    credits.forEach(function(c){
      const $item = $('<div class="list-group-item"></div>').html(
        '<div class="d-flex justify-content-between align-items-center">' +
          '<div><small class="text-muted">Credit from Invoice #' + esc(c.source_invoice_id || c.source_invoice || 'N/A') + '</small><div>Remaining: <strong>৳' + formatMoney(c.remaining_amount || c.remaining_credit || 0) + '</strong></div></div>' +
          '<small class="text-muted">' + esc(c.created_at || '') + '</small>' +
        '</div>'
      );
      $overpaymentCreditsList.append($item);
    });
  }

  // actions: view/edit/record using $.ajax
  window.viewInvoice = function(invoiceId) {
    if (!invoiceId) return alert('Invalid invoice id');
    const url = Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_invoice_detail&invoice_id=' + encodeURIComponent(invoiceId);
    $.ajax({
      url: url,
      method: 'GET',
      dataType: 'json',
      success: function(data) {
        if (data && parseInt(data.status || 0) === 200 && data.invoice) {
          const inv = data.invoice;
          let out = 'Invoice #: ' + esc(inv.invoice_number || '') + '\n';
          out += 'Type: ' + esc(inv.invoice_type || '') + '\n';
          out += 'Amount: ৳' + formatMoney(inv.amount || 0) + '\n';
          out += 'Paid: ৳' + formatMoney(inv.paid_amount || 0) + '\n';
          out += 'Remaining: ৳' + formatMoney((inv.remaining_amount != null) ? inv.remaining_amount : ((inv.amount || 0) - (inv.paid_amount || 0))) + '\n';
          out += 'Date: ' + esc(inv.invoice_date || '') + '\n';
          out += 'Due: ' + esc(inv.due_date || '-') + '\n';
          out += 'Status: ' + esc(inv.status || '') + '\n';
          out += 'Notes: ' + esc(inv.notes || inv.description || '');
          alert(out);
        } else {
          alert('Invoice not found');
        }
      },
      error: function() { alert('Failed to load invoice details'); }
    });
  };

  window.editInvoice = function(invoiceId) {
    if (!invoiceId) return alert('Invalid invoice id');
    const url = Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_invoice_detail&invoice_id=' + encodeURIComponent(invoiceId);
    $.ajax({
      url: url,
      method: 'GET',
      dataType: 'json',
      success: function(data) {
        if (data && parseInt(data.status || 0) === 200 && data.invoice) {
          const inv = data.invoice;
          $('#createInvoiceModal').modal('show');
          if (inv.purchase_id) {
            if ($purchaseSel.find('option[value="'+inv.purchase_id+'"]').length === 0) {
              $purchaseSel.append('<option value="'+inv.purchase_id+'">Purchase ' + inv.purchase_id + '</option>');
            }
            $purchaseSel.val(inv.purchase_id).trigger('change');
          }
          $('#invoice_type_select').val(inv.invoice_type || '').trigger('change');
          $('#invoice_amount').val((parseFloat(inv.amount || 0)).toFixed(2));
          $('#invoice_date').val(inv.invoice_date || '');
          $('#invoice_due_date').val(inv.due_date || '');
          $('#invoice_description').val(inv.description || inv.notes || '');
          $('#createInvoiceModal').data('editInvoiceId', inv.id);
          alert('Invoice loaded into Create modal. Submitting will create a NEW invoice unless an update endpoint is implemented on the backend.');
        } else {
          alert('Invoice not found for editing');
        }
      },
      error: function() { alert('Failed to load invoice for edit'); }
    });
  };

  window.recordInvoicePayment = function(invoiceId) {
    if (!invoiceId) return alert('Invalid invoice id');
    const detailUrl = Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_invoice_detail&invoice_id=' + encodeURIComponent(invoiceId);
    $.ajax({
      url: detailUrl,
      method: 'GET',
      dataType: 'json',
      success: function(data) {
        if (!data || parseInt(data.status || 0) !== 200 || !data.invoice) return alert('Invoice not found');
        const inv = data.invoice;
        const purchaseId = inv.purchase_id || $purchaseSel.val() || '';

        const unpaid = (parseFloat(inv.amount || 0) - parseFloat(inv.paid_amount || 0)) || 0;
        const sAmount = prompt('Enter payment amount (remaining: ' + formatMoney(unpaid) + ')', unpaid.toFixed(2));
        if (sAmount === null) return;
        const amount = parseFloat(sAmount);
        if (isNaN(amount) || amount <= 0) return alert('Invalid amount');

        const method = prompt('Payment method (cash, bkash, bank...)', 'cash') || 'cash';
        const reference = prompt('Reference (optional)', '') || '';
        const notes = prompt('Notes (optional)', '') || '';

        // prepare POST body (jQuery will encode arrays correctly for invoice_ids[])
        const body = {
          purchase_id: purchaseId,
          amount: amount,
          payment_date: (new Date()).toISOString().slice(0,10),
          payment_method: method,
          reference: reference,
          notes: notes,
          'invoice_ids[]': [invoiceId]
        };

        const postUrl = Wo_Ajax_Requests_File() + '?f=manage_inventory&s=record_payment';
        $.ajax({
          url: postUrl,
          method: 'POST',
          dataType: 'json',
          data: body,
          success: function(resp) {
            if (resp && parseInt(resp.status || 0) === 200) {
              alert('Payment recorded. Receipt: ' + (resp.receipt_number || resp.receipt_id || 'N/A'));
              loadInvoices();
            } else {
              alert('Failed to record payment: ' + (resp && resp.message ? resp.message : 'unknown'));
            }
          },
          error: function() { alert('Error recording payment'); }
        });
      },
      error: function() { alert('Failed to fetch invoice details'); }
    });
  };

  // init on load
  initClientSelect2();
  clearInvoicesPlaceholder();

  // prefill from page-level ui_purchase_id / ui_client_id if present
  const prePurchase = $('#ui_purchase_id').val();
  
  // Quick Filter Handlers
  $('.quick-filter').on('click', function() {
    var filter = $(this).data('filter');
    var today = new Date();
    var fromDate, toDate;
    
    switch(filter) {
      case 'this_month':
        fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
        toDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
        break;
      case 'last_month':
        fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
        toDate = new Date(today.getFullYear(), today.getMonth(), 0);
        break;
      case 'this_quarter':
        var quarter = Math.floor(today.getMonth() / 3);
        fromDate = new Date(today.getFullYear(), quarter * 3, 1);
        toDate = new Date(today.getFullYear(), quarter * 3 + 3, 0);
        break;
      case 'overdue':
        $('#invoice_filter_status').val('overdue');
        $('#btn_invoice_apply_filter').click();
        return;
      case 'pending':
        $('#invoice_filter_status').val('partial');
        $('#btn_invoice_apply_filter').click();
        return;
    }
    
    if (fromDate && toDate) {
      $('#invoice_filter_from').val(formatDate(fromDate));
      $('#invoice_filter_to').val(formatDate(toDate));
      $('#btn_invoice_apply_filter').click();
    }
  });
  
  function formatDate(date) {
    return date.getFullYear() + '-' + 
           String(date.getMonth() + 1).padStart(2, '0') + '-' + 
           String(date.getDate()).padStart(2, '0');
  }
  
  // Bulk Selection
  $(document).on('change', '.invoice-checkbox', function() {
    var invoiceId = $(this).val();
    if ($(this).is(':checked')) {
      selectedInvoices.push(invoiceId);
    } else {
      selectedInvoices = selectedInvoices.filter(id => id !== invoiceId);
    }
    updateBulkBar();
  });
  
  function updateBulkBar() {
    if (selectedInvoices.length > 0) {
      $('#invoice_selected_count').text(selectedInvoices.length);
      $('#invoice_bulk_operations').show();
    } else {
      $('#invoice_bulk_operations').hide();
    }
  }
  
  // Bulk Export PDF
  $('#btn_bulk_export_pdf').on('click', function() {
    if (selectedInvoices.length === 0) {
      alert('Please select invoices first');
      return;
    }
    
    $(this).prop('disabled', true).html('<i class="lni lni-spinner-arrow lni-spin"></i> Exporting...');
    
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=bulk_export_invoices_pdf', {
      invoice_ids: selectedInvoices.join(',')
    })
    .done(function(resp) {
      var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
      if (data.status === 200) {
        alert(data.message);
        if (data.download_url) {
          window.open(data.download_url, '_blank');
        }
      } else {
        alert(data.message || 'Export failed');
      }
    })
    .fail(function() {
      alert('Server error during export');
    })
    .always(function() {
      $('#btn_bulk_export_pdf').prop('disabled', false).html('<i class="lni lni-download"></i> Export PDF');
    });
  });
  
  // Bulk Export Excel
  $('#btn_bulk_export_excel').on('click', function() {
    if (selectedInvoices.length === 0) {
      alert('Please select invoices first');
      return;
    }
    
    $(this).prop('disabled', true).html('<i class="lni lni-spinner-arrow lni-spin"></i> Exporting...');
    
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=bulk_export_invoices_excel', {
      invoice_ids: selectedInvoices.join(',')
    })
    .done(function(resp) {
      var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
      if (data.status === 200) {
        alert(data.message);
        if (data.download_url) {
          window.open(data.download_url, '_blank');
        }
      } else {
        alert(data.message || 'Export failed');
      }
    })
    .fail(function() {
      alert('Server error during export');
    })
    .always(function() {
      $('#btn_bulk_export_excel').prop('disabled', false).html('<i class="lni lni-file-excel"></i> Export Excel');
    });
  });
  
  // Bulk Send Emails
  $('#btn_bulk_send_email').on('click', function() {
    if (selectedInvoices.length === 0) {
      alert('Please select invoices first');
      return;
    }
    
    if (!confirm('Send invoice emails to ' + selectedInvoices.length + ' clients?')) {
      return;
    }
    
    $(this).prop('disabled', true).html('<i class="lni lni-spinner-arrow lni-spin"></i> Sending...');
    
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=bulk_send_invoice_emails', {
      invoice_ids: selectedInvoices.join(',')
    })
    .done(function(resp) {
      var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
      if (data.status === 200) {
        alert(data.message + '\nQueued: ' + data.queued + '\nFailed: ' + data.failed);
      } else {
        alert(data.message || 'Send failed');
      }
    })
    .fail(function() {
      alert('Server error during send');
    })
    .always(function() {
      $('#btn_bulk_send_email').prop('disabled', false).html('<i class="lni lni-envelope"></i> Send Emails');
    });
  });
  
  // Bulk Void
  $('#btn_bulk_void').on('click', function() {
    if (selectedInvoices.length === 0) {
      alert('Please select invoices first');
      return;
    }
    
    var reason = prompt('Reason for voiding ' + selectedInvoices.length + ' invoices:');
    if (!reason) return;
    
    $(this).prop('disabled', true).html('<i class="lni lni-spinner-arrow lni-spin"></i> Voiding...');
    
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=bulk_void_invoices', {
      invoice_ids: selectedInvoices.join(','),
      reason: reason
    })
    .done(function(resp) {
      var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
      if (data.status === 200) {
        alert(data.message);
        selectedInvoices = [];
        updateBulkBar();
        // Reload invoices table
        if (typeof loadInvoices === 'function') {
          loadInvoices();
        }
      } else {
        alert(data.message || 'Void failed');
      }
    })
    .fail(function() {
      alert('Server error during void');
    })
    .always(function() {
      $('#btn_bulk_void').prop('disabled', false).html('<i class="lni lni-trash"></i> Void Selected');
    });
  });
});
</script>