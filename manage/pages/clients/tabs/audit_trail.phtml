// Audit Trail Tab - Comprehensive audit log of all actions
// Path: manage/pages/clients/tabs/audit_trail.phtml
?>

<div class="tab-pane" id="tab_audit_trail" role="tabpanel">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <div class="d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="lni lni-history me-2"></i>Audit Trail & Activity Log
        </h6>
        <button class="btn btn-sm btn-outline-secondary" id="btn_audit_filter">
          <i class="lni lni-filter me-1"></i>Filter
        </button>
      </div>
    </div>

    <div class="card-body p-3">
      <!-- Filter Panel -->
      <div id="audit_filter_panel" class="row mb-3" style="display:none;">
        <div class="col-md-2">
          <select class="form-select form-select-sm" id="audit_filter_module">
            <option value="">All Modules</option>
            <option value="payment_schedule">Payment Schedule</option>
            <option value="invoice">Invoice</option>
            <option value="email">Email/SMS</option>
            <option value="refund">Refund</option>
            <option value="reschedule">Reschedule</option>
            <option value="approval">Admin Approval</option>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select form-select-sm" id="audit_filter_action">
            <option value="">All Actions</option>
            <option value="create">Create</option>
            <option value="update">Update</option>
            <option value="delete">Delete</option>
            <option value="approve">Approve</option>
            <option value="reject">Reject</option>
            <option value="send_email">Send Email</option>
          </select>
        </div>
        <div class="col-md-2">
          <input type="date" class="form-control form-control-sm" id="audit_filter_from">
        </div>
        <div class="col-md-2">
          <input type="date" class="form-control form-control-sm" id="audit_filter_to">
        </div>
        <div class="col-md-2">
          <input type="text" class="form-control form-control-sm" id="audit_filter_user" placeholder="User name...">
        </div>
        <div class="col-md-2">
          <button class="btn btn-sm btn-primary w-100" id="btn_audit_apply_filter">Apply</button>
        </div>
        <div class="col-md-1">
          <button class="btn btn-sm btn-outline-secondary w-100" id="btn_audit_reset_filter" title="Reset">
            <i class="lni lni-close"></i>
          </button>
        </div>
      </div>

      <!-- Audit Timeline -->
      <div class="timeline" id="audit_timeline">
        <!-- Loaded via AJAX -->
      </div>
    </div>
  </div>
</div>

<style>
.timeline {
  position: relative;
  padding: 20px 0;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 30px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #dee2e6;
}

.timeline-item {
  margin-bottom: 30px;
  padding-left: 80px;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 15px;
  top: 5px;
  width: 30px;
  height: 30px;
  background: #fff;
  border: 3px solid #0d6efd;
  border-radius: 50%;
  z-index: 1;
}

.timeline-item.success::before {
  border-color: #198754;
  background-color: #f1f3f5;
}

.timeline-item.danger::before {
  border-color: #dc3545;
  background-color: #f1f3f5;
}

.timeline-item.warning::before {
  border-color: #ffc107;
  background-color: #f1f3f5;
}

.timeline-content {
  background: #f8f9fa;
  padding: 15px;
  border-radius: 0.25rem;
  border-left: 3px solid #0d6efd;
}

.timeline-item.success .timeline-content {
  border-left-color: #198754;
}

.timeline-item.danger .timeline-content {
  border-left-color: #dc3545;
}

.timeline-item.warning .timeline-content {
  border-left-color: #ffc107;
}

.timeline-meta {
  font-size: 0.85rem;
  color: #6c757d;
  margin-top: 8px;
}
</style>

<script>
// Audit Trail Tab
document.addEventListener('DOMContentLoaded', function() {
  const auditTab = document.getElementById('tab_audit_trail');
  if (!auditTab) return;

  // Load audit on tab show
  auditTab.addEventListener('show.bs.tab', function() {
    loadAuditTrail();
  });

  // Toggle filter
  document.getElementById('btn_audit_filter').addEventListener('click', function() {
    const filterPanel = document.getElementById('audit_filter_panel');
    filterPanel.style.display = filterPanel.style.display === 'none' ? 'grid' : 'none';
  });

  function loadAuditTrail(filters = {}) {
    const purchaseId = document.getElementById('ui_purchase_id')?.value;
    if (!purchaseId) return;

    fetch('/xhr/manage_inventory.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        action: 'get_audit_trail',
        purchase_id: purchaseId,
        module: filters.module || '',
        action: filters.action || '',
        from_date: filters.from_date || '',
        to_date: filters.to_date || '',
        user_name: filters.user_name || ''
      })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        renderAuditTimeline(data.audit_logs);
      }
    })
    .catch(e => console.error('[v0] Error loading audit:', e));
  }

  function renderAuditTimeline(logs) {
    const timeline = document.getElementById('audit_timeline');
    timeline.innerHTML = '';

    if (!logs || logs.length === 0) {
      timeline.innerHTML = '<p class="text-center text-muted py-5">No audit logs found</p>';
      return;
    }

    logs.forEach(log => {
      const typeClass = log.action === 'delete' ? 'danger' : (log.action === 'approve' ? 'success' : 'warning');
      const item = document.createElement('div');
      item.className = `timeline-item ${typeClass}`;
      item.innerHTML = `
        <div class="timeline-content">
          <h6 class="mb-2">
            <span class="badge bg-primary">${log.module}</span>
            <span class="badge" style="background-color: ${getActionColor(log.action)}">${log.action}</span>
          </h6>
          <p class="mb-2">${log.description}</p>
          ${log.old_values ? `
            <details class="mt-2">
              <summary style="cursor: pointer; color: #6c757d; font-size: 0.85rem;">View Changes</summary>
              <div class="mt-2 small" style="background-color: #fff; padding: 10px; border-radius: 0.25rem;">
                <strong>Before:</strong><br>
                <code>${JSON.stringify(log.old_values, null, 2)}</code>
                <br><strong>After:</strong><br>
                <code>${JSON.stringify(log.new_values, null, 2)}</code>
              </div>
            </details>
          ` : ''}
          <div class="timeline-meta">
            <i class="lni lni-user me-1"></i>${log.changed_by_name} •
            <i class="lni lni-calendar me-1"></i>${log.created_at} •
            <i class="lni lni-network me-1"></i>${log.ip_address}
          </div>
        </div>
      `;
      timeline.appendChild(item);
    });
  }

  function getActionColor(action) {
    const colors = {
      'create': '#28a745',
      'update': '#ffc107',
      'delete': '#dc3545',
      'approve': '#17a2b8',
      'reject': '#dc3545',
      'send_email': '#007bff'
    };
    return colors[action] || '#6c757d';
  }

  // Filter handlers
  document.getElementById('btn_audit_apply_filter').addEventListener('click', function() {
    const filters = {
      module: document.getElementById('audit_filter_module').value,
      action: document.getElementById('audit_filter_action').value,
      from_date: document.getElementById('audit_filter_from').value,
      to_date: document.getElementById('audit_filter_to').value,
      user_name: document.getElementById('audit_filter_user').value
    };
    loadAuditTrail(filters);
  });

  document.getElementById('btn_audit_reset_filter').addEventListener('click', function() {
    document.getElementById('audit_filter_module').value = '';
    document.getElementById('audit_filter_action').value = '';
    document.getElementById('audit_filter_from').value = '';
    document.getElementById('audit_filter_to').value = '';
    document.getElementById('audit_filter_user').value = '';
    loadAuditTrail();
  });
});
</script>
