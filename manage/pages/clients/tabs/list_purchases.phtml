<script>
$(document).ready(function() {
    // Initialize DataTable
    const purchasesTable = $('#purchasesDataTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_purchases_list',
            type: 'POST',
            data: function(d) {
                d.search = $('#searchPurchases').val();
                d.project_filter = $('#filterProject').val();
                d.status_filter = $('#filterStatus').val();
            }
        },
        columns: [
            { data: 'file_num', name: 'file_num' },
            { data: 'client_name', name: 'client_name' },
            { data: 'project', name: 'project' },
            { data: 'block', name: 'block' },
            { data: 'plot', name: 'plot' },
            { data: 'katha', name: 'katha' },
            { 
                data: 'total_price', 
                name: 'total_price',
                render: function(data) {
                    return '৳' + parseFloat(data).toLocaleString('en-BD', {minimumFractionDigits: 2});
                }
            },
            { 
                data: 'total_paid', 
                name: 'total_paid',
                render: function(data) {
                    return '৳' + parseFloat(data).toLocaleString('en-BD', {minimumFractionDigits: 2});
                }
            },
            { 
                data: 'total_due', 
                name: 'total_due',
                render: function(data, type, row) {
                    const due = parseFloat(data);
                    const color = due > 0 ? 'text-danger' : 'text-success';
                    return '<span class="' + color + '">৳' + due.toLocaleString('en-BD', {minimumFractionDigits: 2}) + '</span>';
                }
            },
            { 
                data: 'status_label', 
                name: 'status_label',
                render: function(data, type, row) {
                    const badges = {
                        'Active': 'bg-info',
                        'Sold': 'bg-success',
                        'Complete': 'bg-primary',
                        'Cancelled': 'bg-danger',
                        'Available': 'bg-secondary'
                    };
                    const badgeClass = badges[data] || 'bg-secondary';
                    return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                }
            },
            { 
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-info view-client-btn" data-client-id="${row.client_id}" title="View Client">
                                <i class="lni lni-user"></i>
                            </button>
                            <button class="btn btn-success payment-schedule-btn" data-purchase-id="${row.purchase_id}" title="Payment Schedule">
                                <i class="lni lni-dollar"></i>
                            </button>
                            <button class="btn btn-warning manage-btn" data-purchase-id="${row.purchase_id}" title="Manage">
                                <i class="lni lni-cog"></i>
                            </button>
                        </div>
                    `;
                }
            }
        ],
        order: [[0, 'desc']],
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
        language: {
            search: "Search:",
            lengthMenu: "Show _MENU_ entries",
            info: "Showing _START_ to _END_ of _TOTAL_ purchases",
            infoEmpty: "No purchases found",
            infoFiltered: "(filtered from _MAX_ total purchases)",
            loadingRecords: "Loading purchases...",
            processing: "Processing...",
            zeroRecords: "No matching purchases found"
        },
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
        responsive: true,
        autoWidth: false
    });

    // Custom search trigger
    $('#searchPurchases').on('keyup', function() {
        purchasesTable.ajax.reload();
    });

    // Filter triggers
    $('#filterProject, #filterStatus').on('change', function() {
        purchasesTable.ajax.reload();
    });

    // Clear filters
    $('#clearFilters').on('click', function() {
        $('#searchPurchases').val('');
        $('#filterProject').val('');
        $('#filterStatus').val('');
        purchasesTable.ajax.reload();
    });

    // Action button handlers
    $('#purchasesDataTable').on('click', '.view-client-btn', function() {
        const clientId = $(this).data('client-id');
        // Open view client modal
        if (typeof Wo_OpenClientView === 'function') {
            Wo_OpenClientView(clientId);
        } else {
            // Fallback: navigate to client page
            window.location.href = Wo_SiteUrl() + '/manage/clients/' + clientId;
        }
    });

    $('#purchasesDataTable').on('click', '.payment-schedule-btn', function() {
        const purchaseId = $(this).data('purchase-id');
        // Open payment schedule modal
        if (typeof window.openPaymentSchedule === 'function') {
            window.openPaymentSchedule(purchaseId);
        } else if (typeof updateInstallmentModal === 'function') {
            updateInstallmentModal(purchaseId);
        } else {
            alert('Payment schedule function not available');
        }
    });

    $('#purchasesDataTable').on('click', '.manage-btn', function() {
        const purchaseId = $(this).data('purchase-id');
        // Open management options dropdown or modal
        // For now, open payment schedule as it's the primary management interface
        if (typeof window.openPaymentSchedule === 'function') {
            window.openPaymentSchedule(purchaseId);
        }
    });

    // Handle Add Purchase from list (without client context)
    $('#addPurchaseFromList').on('click', function() {
        if (typeof window.resetAddPurchaseForm === 'function') {
            window.resetAddPurchaseForm(null);
        } else {
            // Fallback if function not loaded yet
            $('#contextClientId').val('');
            $('#clientSection').show();
            $('#addPurchaseForm')[0].reset();
            window.generatedSchedule = null;
            $('#schedulePreviewSection').hide();
        }
    });
});
</script>

