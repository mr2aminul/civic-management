      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="btn_send_composed_email">
          <i class="lni lni-send me-1"></i>Send Email
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle recipient type change
    const recipientSelect = document.getElementById('compose_recipient_type');
    const customEmailDiv = document.getElementById('compose_custom_email_div');
    
    if(recipientSelect) {
        recipientSelect.addEventListener('change', function() {
            if(this.value === 'custom') {
                customEmailDiv.style.display = 'block';
                customEmailDiv.querySelector('input').required = true;
            } else {
                customEmailDiv.style.display = 'none';
                customEmailDiv.querySelector('input').required = false;
            }
        });
    }

    // Handle Send Button
    const sendBtn = document.getElementById('btn_send_composed_email');
    if(sendBtn) {
        sendBtn.addEventListener('click', function() {
            const form = document.getElementById('composeEmailForm');
            if(!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const purchaseId = document.getElementById('ui_purchase_id')?.value;
            if(purchaseId) formData.append('purchase_id', purchaseId);

            const btn = this;
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="lni lni-spinner lni-spin me-1"></i>Sending...';

            // Convert FormData to object
            const data = {};
            formData.forEach((value, key) => data[key] = value);
            data.s = 'send_composed_email'; // Backend handler needed

            $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory', data)
            .done(function(resp) {
                const res = typeof resp === 'string' ? JSON.parse(resp) : resp;
                if(res.status === 200) {
                    alert('Email sent/queued successfully');
                    const modalEl = document.getElementById('composeEmailModal');
                    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.hide();
                    form.reset();
                    // Reload list if function exists
                    if(typeof loadEmails === 'function') loadEmails('pending');
                } else {
                    alert(res.message || 'Failed to send email');
                }
            })
            .fail(function() {
                alert('Server error');
            })
            .always(function() {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            });
        });
    }
});
</script>
