<script>
document.addEventListener('DOMContentLoaded', function() {
  const emailTab = document.getElementById('tab_pending_emails');
  if (!emailTab) return;

  emailTab.addEventListener('show.bs.tab', function() {
    loadEmails('pending');
  });

  document.getElementById('btn_email_filter_toggle').addEventListener('click', function() {
    const panel = document.getElementById('email_filter_panel');
    panel.style.display = panel.style.display === 'none' ? 'grid' : 'none';
  });

  document.getElementById('btn_email_apply_filter').addEventListener('click', function() {
    loadEmails('pending');
  });

  document.getElementById('btn_email_reset_filter').addEventListener('click', function() {
    document.getElementById('email_filter_type').value = '';
    document.getElementById('email_filter_recipient').value = '';
    document.getElementById('email_filter_search').value = '';
    loadEmails('pending');
  });

  // Tab switching
  document.getElementById('email_tab_pending').addEventListener('click', function() {
    loadEmails('pending');
  });

  document.getElementById('email_tab_sent').addEventListener('click', function() {
    loadEmails('sent');
  });

  function loadEmails(type = 'pending') {
    const purchaseId = document.getElementById('ui_purchase_id')?.value;
    if (!purchaseId) return;

    fetch('/xhr/manage_inventory.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        action: 'get_emails',
        purchase_id: purchaseId,
        email_status: type,
        email_type: document.getElementById('email_filter_type').value || '',
        recipient_type: document.getElementById('email_filter_recipient').value || '',
        search: document.getElementById('email_filter_search').value || ''
      })
    })
    .then(r => r.json())
    .then(data => {
      if (type === 'pending') {
        renderPendingEmails(data.emails || []);
        document.getElementById('email_pending_count').textContent = data.emails?.length || 0;
      } else {
        renderSentEmails(data.emails || []);
        document.getElementById('email_sent_count').textContent = data.emails?.length || 0;
      }
    })
    .catch(e => console.error('[v0] Error loading emails:', e));
  }

  function renderPendingEmails(emails) {
    const tbody = document.getElementById('email_pending_tbody');
    tbody.innerHTML = '';

    if (emails.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">No pending emails</td></tr>';
      return;
    }

    emails.forEach(email => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><input type="checkbox" class="form-check-input email-checkbox" data-id="${email.id}"></td>
        <td><strong>${email.recipient_name}</strong><br><small class="text-muted">${email.recipient_email}</small></td>
        <td><span class="badge bg-secondary">${email.email_type}</span></td>
        <td><small>${email.subject || '-'}</small></td>
        <td><small>${email.scheduled_for || 'Now'}</small></td>
        <td><span class="badge bg-warning">Pending</span></td>
        <td>
          <button class="btn btn-xs btn-outline-primary" onclick="previewEmail(${email.id})" title="Preview">
            <i class="lni lni-eye"></i>
          </button>
          <button class="btn btn-xs btn-outline-success" onclick="sendEmailNow(${email.id})" title="Send">
            <i class="lni lni-send"></i>
          </button>
        </td>
      `;
      tbody.appendChild(row);
    });
  }

  function renderSentEmails(emails) {
    const tbody = document.getElementById('email_sent_tbody');
    tbody.innerHTML = '';

    if (emails.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">No sent emails</td></tr>';
      return;
    }

    emails.forEach(email => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><strong>${email.recipient_name}</strong><br><small class="text-muted">${email.recipient_email}</small></td>
        <td><span class="badge bg-secondary">${email.email_type}</span></td>
        <td><small>${email.subject || '-'}</small></td>
        <td><small>${email.sent_at}</small></td>
        <td><small>${email.sent_by || 'System'}</small></td>
        <td><span class="badge bg-success">Sent</span></td>
        <td>
          <button class="btn btn-xs btn-outline-primary" onclick="previewEmail(${email.id})" title="View">
            <i class="lni lni-eye"></i>
          </button>
        </td>
      `;
      tbody.appendChild(row);
    });
  }
});

function previewEmail(emailId) {
  // Simple preview using alert for now, or could open a modal
  // Ideally fetch full content via AJAX if body is large
  alert('Preview functionality coming soon for email #' + emailId);
}

function sendEmailNow(emailId) {
  if (!confirm('Send this email immediately?')) return;

  const btn = document.querySelector(`button[onclick="sendEmailNow(${emailId})"]`);
  if(btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="lni lni-spinner lni-spin"></i>';
  }

  $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=send_email', {
    email_id: emailId
  })
  .done(function(resp) {
    const data = typeof resp === 'string' ? JSON.parse(resp) : resp;
    if (data.status === 200) {
      // Refresh list
      const tab = document.querySelector('.nav-link.active');
      if(tab) tab.click(); // Reload current tab
      if(typeof toastr !== 'undefined') toastr.success('Email sent successfully');
      else alert('Email sent successfully');
    } else {
      if(typeof toastr !== 'undefined') toastr.error(data.message || 'Failed to send email');
      else alert(data.message || 'Failed to send email');
      if(btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="lni lni-send"></i>';
      }
    }
  })
  .fail(function() {
    alert('Server error sending email');
    if(btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="lni lni-send"></i>';
    }
  });
}
</script>

<!-- Compose Email Modal -->
