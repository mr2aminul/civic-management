<?php
/**
 * Pending Emails Tab - Communication Queue Management
 * Path: manage/pages/clients/tabs/pending_emails.phtml
 * Rebuilt for reliability and proper error handling
 */
?>

<div class="tab-pane" id="tab_pending_emails" role="tabpanel">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <div class="d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="lni lni-envelope me-2"></i>Communication Queue
          <span class="badge bg-warning ms-2" id="comm_pending_count">0</span>
          <span class="badge bg-success ms-1" id="comm_sent_count">0</span>
        </h6>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" id="btn_refresh_queue">
            <i class="lni lni-reload me-1"></i>Refresh
          </button>
          <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#composeMessageModal">
            <i class="lni lni-pencil me-1"></i>Compose
          </button>
        </div>
      </div>
    </div>

    <div class="card-body p-3">
      <!-- Filters -->
      <div class="row mb-3 g-2">
        <div class="col-md-4">
          <label class="form-label small">Filter by Client</label>
          <select class="form-select form-select-sm" id="comm_filter_client">
            <option value="">All Clients</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Filter by Purchase</label>
          <select class="form-select form-select-sm" id="comm_filter_purchase">
            <option value="">All Purchases</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Filter by Type</label>
          <select class="form-select form-select-sm" id="comm_filter_type">
            <option value="">All Types</option>
            <option value="email">Email Only</option>
            <option value="sms">SMS Only</option>
          </select>
        </div>
      </div>

      <!-- Tabs for Pending/Sent -->
      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="comm_tab_pending" data-bs-toggle="tab" data-bs-target="#comm_content_pending" type="button">
            <i class="lni lni-hourglass me-1"></i>Pending
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="comm_tab_sent" data-bs-toggle="tab" data-bs-target="#comm_content_sent" type="button">
            <i class="lni lni-checkmark-circle me-1"></i>Sent
          </button>
        </li>
      </ul>

      <!-- Tab Content -->
      <div class="tab-content">
        <!-- Pending Communications -->
        <div class="tab-pane fade show active" id="comm_content_pending" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead class="table-light">
                <tr>
                  <th width="50">Type</th>
                  <th>Recipient</th>
                  <th>Content</th>
                  <th width="120">Scheduled</th>
                  <th width="80">Status</th>
                  <th width="100">Actions</th>
                </tr>
              </thead>
              <tbody id="comm_pending_tbody">
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Loading queue...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Sent Communications -->
        <div class="tab-pane fade" id="comm_content_sent" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead class="table-light">
                <tr>
                  <th width="50">Type</th>
                  <th>Recipient</th>
                  <th>Content</th>
                  <th width="120">Sent At</th>
                  <th width="80">Status</th>
                  <th width="80">Actions</th>
                </tr>
              </thead>
              <tbody id="comm_sent_tbody">
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Loading history...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Configuration
  const CONFIG = {
    debug: true,
    endpoints: {
      getEmails: '?f=manage_inventory&s=get_emails',
      getSms: '?f=manage_inventory&s=get_sms',
      sendEmail: '?f=manage_inventory&s=send_email',
      sendSms: '?f=manage_inventory&s=send_sms',
      deleteEmail: '?f=manage_inventory&s=delete_queued_email',
      deleteSms: '?f=manage_inventory&s=delete_sms'
    }
  };
  
  // Utility functions
  const utils = {
    log: (...args) => {
      if (CONFIG.debug) console.log('[CommQueue]', ...args);
    },
    error: (...args) => {
      console.error('[CommQueue]', ...args);
    },
    escapeHtml: (str) => {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    },
    truncate: (str, maxLen = 50) => {
      if (!str) return '';
      str = String(str);
      return str.length > maxLen ? str.substring(0, maxLen) + '...' : str;
    },
    formatDate: (dateStr) => {
      if (!dateStr) return '-';
      try {
        const date = new Date(dateStr);
        return date.toLocaleString('en-GB', { 
          day: '2-digit', 
          month: 'short', 
          hour: '2-digit', 
          minute: '2-digit' 
        });
      } catch (e) {
        return dateStr;
      }
    }
  };
  
  // State management
  const state = {
    clientId: null,
    purchaseId: null,
    currentTab: 'pending',
    data: {
      pending: [],
      sent: []
    }
  };
  
  // API functions
  const api = {
    fetchEmails: async (status) => {
      try {
        const data = {};
        
        // Add filters if set
        if (state.clientId) data.client_id = state.clientId;
        if (state.purchaseId) data.purchase_id = state.purchaseId;
        if (status) data.status = status;
        
        const response = await $.ajax({
          url: Wo_Ajax_Requests_File() + CONFIG.endpoints.getEmails,
          type: 'POST',
          data: data,
          dataType: 'json'
        });
        
        if (response && response.status === 200 && Array.isArray(response.emails)) {
          return response.emails.map(e => ({ ...e, type: 'email' }));
        }
        return [];
      } catch (error) {
        utils.error('Failed to fetch emails:', error);
        return [];
      }
    },
    
    fetchSms: async (status) => {
      try {
        const data = {};
        
        // Add filters if set
        if (state.clientId) data.client_id = state.clientId;
        if (state.purchaseId) data.purchase_id = state.purchaseId;
        if (status) data.status = status;
        
        const response = await $.ajax({
          url: Wo_Ajax_Requests_File() + CONFIG.endpoints.getSms,
          type: 'POST',
          data: data,
          dataType: 'json'
        });
        
        if (response && response.status === 200 && Array.isArray(response.sms)) {
          return response.sms.map(s => ({ ...s, type: 'sms' }));
        }
        return [];
      } catch (error) {
        utils.error('Failed to fetch SMS:', error);
        return [];
      }
    },
    
    sendItem: async (id, type) => {
      const endpoint = type === 'email' ? CONFIG.endpoints.sendEmail : CONFIG.endpoints.sendSms;
      const param = type === 'email' ? 'email_id' : 'sms_id';
      
      try {
        const response = await $.ajax({
          url: Wo_Ajax_Requests_File() + endpoint,
          type: 'POST',
          data: { [param]: id },
          dataType: 'json'
        });
        
        return response && response.status === 200;
      } catch (error) {
        utils.error('Failed to send item:', error);
        return false;
      }
    },
    
    deleteItem: async (id, type) => {
      const endpoint = type === 'email' ? CONFIG.endpoints.deleteEmail : CONFIG.endpoints.deleteSms;
      const param = type === 'email' ? 'email_id' : 'sms_id';
      
      try {
        const response = await $.ajax({
          url: Wo_Ajax_Requests_File() + endpoint,
          type: 'POST',
          data: { [param]: id },
          dataType: 'json'
        });
        
        return response && response.status === 200;
      } catch (error) {
        utils.error('Failed to delete item:', error);
        return false;
      }
    }
  };
  
  // Rendering functions
  const render = {
    pending: (items) => {
      const tbody = document.getElementById('comm_pending_tbody');
      if (!tbody) return;
      
      tbody.innerHTML = '';
      
      if (!items || items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              <i class="lni lni-inbox" style="font-size: 2rem; opacity: 0.3;"></i>
              <div class="mt-2">No pending items</div>
            </td>
          </tr>
        `;
        return;
      }
      
      items.forEach(item => {
        const isEmail = item.type === 'email';
        const icon = isEmail 
          ? '<i class="lni lni-envelope text-primary"></i>' 
          : '<i class="lni lni-comments text-info"></i>';
        
        const recipientName = utils.escapeHtml(item.recipient_name || 'Unknown');
        const recipientContact = isEmail 
          ? utils.escapeHtml(item.recipient_email || '') 
          : utils.escapeHtml(item.recipient_phone || '');
        
        const content = isEmail 
          ? utils.truncate(item.subject || 'No subject', 60)
          : utils.truncate(item.message_body || '', 60);
        
        const scheduledDate = utils.formatDate(item.scheduled_send_date || item.queue_date);
        
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${icon}</td>
          <td>
            <div class="fw-semibold">${recipientName}</div>
            <small class="text-muted">${recipientContact}</small>
          </td>
          <td><small>${utils.escapeHtml(content)}</small></td>
          <td><small>${scheduledDate}</small></td>
          <td><span class="badge bg-warning">Queued</span></td>
          <td>
            <div class="btn-group btn-group-sm">
              <button class="btn btn-outline-success" onclick="window.commQueue.sendNow(${item.id}, '${item.type}')" title="Send Now">
                <i class="lni lni-send"></i>
              </button>
              <button class="btn btn-outline-danger" onclick="window.commQueue.deleteItem(${item.id}, '${item.type}')" title="Delete">
                <i class="lni lni-trash"></i>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(row);
      });
    },
    
    sent: (items) => {
      const tbody = document.getElementById('comm_sent_tbody');
      if (!tbody) return;
      
      tbody.innerHTML = '';
      
      if (!items || items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              <i class="lni lni-inbox" style="font-size: 2rem; opacity: 0.3;"></i>
              <div class="mt-2">No sent items</div>
            </td>
          </tr>
        `;
        return;
      }
      
      items.forEach(item => {
        const isEmail = item.type === 'email';
        const icon = isEmail 
          ? '<i class="lni lni-envelope text-primary"></i>' 
          : '<i class="lni lni-comments text-info"></i>';
        
        const recipientName = utils.escapeHtml(item.recipient_name || 'Unknown');
        const recipientContact = isEmail 
          ? utils.escapeHtml(item.recipient_email || '') 
          : utils.escapeHtml(item.recipient_phone || '');
        
        const content = isEmail 
          ? utils.truncate(item.subject || 'No subject', 60)
          : utils.truncate(item.message_body || '', 60);
        
        const sentDate = utils.formatDate(item.sent_date || item.send_date);
        
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${icon}</td>
          <td>
            <div class="fw-semibold">${recipientName}</div>
            <small class="text-muted">${recipientContact}</small>
          </td>
          <td><small>${utils.escapeHtml(content)}</small></td>
          <td><small>${sentDate}</small></td>
          <td><span class="badge bg-success">Sent</span></td>
          <td>
            <button class="btn btn-sm btn-outline-primary" onclick="window.commQueue.viewItem(${item.id}, '${item.type}')" title="View">
              <i class="lni lni-eye"></i>
            </button>
          </td>
        `;
        tbody.appendChild(row);
      });
    }
  };
  
  // Main controller
  const controller = {
    init: () => {
      utils.log('Initializing communication queue...');
      
      // Get client ID from URL parameter
      const urlParams = new URLSearchParams(window.location.search);
      const clientIdFromUrl = urlParams.get('u') || urlParams.get('client_id');
      if (clientIdFromUrl) {
        state.clientId = clientIdFromUrl;
        utils.log('Client ID from URL:', state.clientId);
      }
      
      // Also try hidden input as fallback
      const clientIdEl = document.getElementById('ui_client_id');
      if (!state.clientId && clientIdEl) {
        state.clientId = clientIdEl.value;
        utils.log('Client ID from hidden input:', state.clientId);
      }
      
      // Get purchase ID (optional)
      const purchaseIdEl = document.getElementById('ui_purchase_id');
      if (purchaseIdEl) {
        state.purchaseId = purchaseIdEl.value;
        utils.log('Purchase ID:', state.purchaseId);
      }
      
      // Bind events
      controller.bindEvents();
      
      // Load initial data
      controller.loadData('pending');
    },
    
    bindEvents: () => {
      // Initialize Select2 for client filter (matching invoices.phtml pattern)
      $('#comm_filter_client').select2({
        placeholder: '-- Search client --',
        minimumInputLength: 1,
        width: '100%',
        allowClear: true,
        ajax: {
          url: Wo_Ajax_Requests_File() + '?f=manage_clients&s=search_clients',
          type: 'POST',
          dataType: 'json',
          delay: 250,
          data: function(params) {
            return {
              q: params.term || '',
              include_purchase: 1,
              include_client_summary: 0,
              page: params.page || 1,
              per_page: 30
            };
          },
          processResults: function(data) {
            var rows = Array.isArray(data) ? data : (data.results && Array.isArray(data.results) ? data.results : []);
            return {
              results: rows.map(function(it){
                return { id: it.id, text: it.text || it.name || '', raw: it };
              })
            };
          }
        },
        templateResult: function(item){ return item && item.text ? $('<div>').text(item.text) : null; },
        templateSelection: function(item){ return item && item.text ? item.text : null; }
      });
      
      // On client select, populate purchases and load data
      $('#comm_filter_client').off('select2:select').on('select2:select', function(e){
        var item = e.params.data;
        var clientId = item ? item.id : '';
        state.clientId = clientId || null;
        
        var purchases = (item.raw && item.raw.purchases) ? item.raw.purchases : [];
        $('#comm_filter_purchase').prop('disabled', true).empty();
        
        if (purchases.length) {
          $('#comm_filter_purchase').append('<option value="">All Purchases</option>');
          purchases.forEach(function(p){
            var val = p.purchase_id || p.id;
            var txt = p.file_num ? (p.file_num + ' (Booking ID: ' + (p.booking_id || val) + ')') : ('Purchase ' + val);
            $('#comm_filter_purchase').append('<option value="'+val+'">'+txt+'</option>');
          });
          $('#comm_filter_purchase').prop('disabled', false);
        } else {
          $('#comm_filter_purchase').append('<option value="">-- No Purchases Found --</option>');
        }
        
        controller.loadData(state.currentTab);
      });
      
      $('#comm_filter_client').off('select2:clear').on('select2:clear', function(){
        state.clientId = null;
        $('#comm_filter_purchase').prop('disabled', true).empty().append('<option value="">All Purchases</option>');
        state.purchaseId = null;
        controller.loadData(state.currentTab);
      });
      
      // Purchase filter change
      $('#comm_filter_purchase').on('change', function() {
        state.purchaseId = $(this).val() || null;
        controller.loadData(state.currentTab);
      });
      
      // Type filter change
      $('#comm_filter_type').on('change', function() {
        controller.loadData(state.currentTab);
      });
      
      // Tab switches
      $('#comm_tab_pending').on('click', () => {
        state.currentTab = 'pending';
        controller.loadData('pending');
      });
      
      $('#comm_tab_sent').on('click', () => {
        state.currentTab = 'sent';
        controller.loadData('sent');
      });
      
      // Refresh button
      $('#btn_refresh_queue').on('click', () => {
        controller.loadData(state.currentTab);
      });
      
      // Tab activation
      $('button[data-bs-target="#tab_pending_emails"]').on('shown.bs.tab', () => {
        utils.log('Tab activated');
        controller.loadData(state.currentTab);
      });
    },
    
    loadData: async (status) => {
      utils.log('Loading data for status:', status);
      
      try {
        // Fetch both emails and SMS
        const [emails, sms] = await Promise.all([
          api.fetchEmails(status),
          api.fetchSms(status)
        ]);
        
        // Merge and sort
        let allItems = [...emails, ...sms];
        allItems.sort((a, b) => {
          const dateA = new Date(a.queue_date || a.sent_date || a.send_date || 0);
          const dateB = new Date(b.queue_date || b.sent_date || b.send_date || 0);
          return dateB - dateA; // Newest first
        });
        
        // Apply type filter
        const typeFilter = $('#comm_filter_type').val();
        if (typeFilter) {
          allItems = allItems.filter(item => item.type === typeFilter);
        }
        
        // Store in state
        state.data[status] = allItems;
        
        // Update counts
        if (status === 'pending') {
          $('#comm_pending_count').text(allItems.length);
        } else {
          $('#comm_sent_count').text(allItems.length);
        }
        
        // Render
        if (status === 'pending') {
          render.pending(allItems);
        } else {
          render.sent(allItems);
        }
        
        utils.log(`Loaded ${allItems.length} items for ${status}`);
      } catch (error) {
        utils.error('Failed to load data:', error);
        
        const tbody = status === 'pending' 
          ? document.getElementById('comm_pending_tbody')
          : document.getElementById('comm_sent_tbody');
        
        if (tbody) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="text-center text-danger py-4">
                <i class="lni lni-warning"></i> Failed to load data. Please try again.
              </td>
            </tr>
          `;
        }
      }
    },
    
    sendNow: async (id, type) => {
      if (!confirm(`Send this ${type} immediately?`)) return;
      
      utils.log('Sending item:', id, type);
      
      const success = await api.sendItem(id, type);
      
      if (success) {
        alert(`${type.toUpperCase()} sent successfully!`);
        controller.loadData('pending');
      } else {
        alert(`Failed to send ${type}. Please try again.`);
      }
    },
    
    deleteItem: async (id, type) => {
      if (!confirm(`Delete this ${type}?`)) return;
      
      utils.log('Deleting item:', id, type);
      
      const success = await api.deleteItem(id, type);
      
      if (success) {
        alert(`${type.toUpperCase()} deleted successfully!`);
        controller.loadData('pending');
      } else {
        alert(`Failed to delete ${type}. Please try again.`);
      }
    },
    
    viewItem: (id, type) => {
      utils.log('View item:', id, type);
      alert('View functionality coming soon!');
    }
  };
  
  // Expose public API
  window.commQueue = {
    sendNow: controller.sendNow,
    deleteItem: controller.deleteItem,
    viewItem: controller.viewItem,
    refresh: () => controller.loadData(state.currentTab)
  };
  
  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', controller.init);
  } else {
    controller.init();
  }
})();
</script>

<?php echo Wo_LoadManagePage('clients/modals/compose_message_preselect', ['is_loaded_from' => 'pending_emails_tab']); ?>
<?php echo Wo_LoadManagePage('clients/modals/compose_message_modal', ['is_loaded_from' => 'pending_emails_tab']); ?>
