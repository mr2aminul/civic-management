    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="lni lni-pencil me-2"></i>Compose Email</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="composeEmailForm">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Recipient Type</label>
              <select class="form-select" name="recipient_type" id="compose_recipient_type" required>
                <option value="client">Client (Primary)</option>
                <option value="nominee">Nominee</option>
                <option value="custom">Custom Email</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email Type</label>
              <select class="form-select" name="email_type" required>
                <option value="general">General Message</option>
                <option value="payment_reminder">Payment Reminder</option>
                <option value="schedule_update">Schedule Update</option>
                <option value="document_request">Document Request</option>
              </select>
            </div>
          </div>
          
          <div class="mb-3" id="compose_custom_email_div" style="display:none;">
            <label class="form-label">Recipient Email</label>
            <input type="email" class="form-control" name="custom_email" placeholder="name@example.com">
          </div>

          <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text" class="form-control" name="subject" required placeholder="Email Subject">
          </div>

          <div class="mb-3">
