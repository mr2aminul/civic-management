            <i class="lni lni-close"></i>
          </button>
        </div>
      </div>

      <!-- Clients Table -->
      <div class="table-responsive">
        <table class="table table-hover table-sm" id="clients_list_table">
          <thead class="table-light">
            <tr>
              <th width="50">#ID</th>
              <th>Client Name</th>
              <th>Phone</th>
              <th>NID</th>
              <th>Projects</th>
              <th>Plots</th>
              <th>Total Due</th>
              <th width="100">Actions</th>
            </tr>
          </thead>
          <tbody id="clients_list_tbody">
            <tr><td colspan="8" class="text-center text-muted py-4">Loading clients...</td></tr>
          </tbody>
        </table>
