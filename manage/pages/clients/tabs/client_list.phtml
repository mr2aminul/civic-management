            {
                extend: 'print',
                text: '<i class="fadeIn animated bx bx-printer"></i>',
                titleAttr: 'Print',
                exportOptions: {
                    columns: ':not(:last-child)'
                }
            }
        ]
    }).container().appendTo('#dataSheet_download');

    window.DataTableRefresh = function() {
        table.ajax.reload(null, false);
    };

    // Custom search input syncs with DataTables search (server-side)
    var searchTimer;
    $('#clientSearch').on('input', function() {
        clearTimeout(searchTimer);
        var val = $(this).val();
        searchTimer = setTimeout(function() {
            table.search(val.trim()).draw();
        }, 450);
    });
    $('#clientSearch').on('keydown', function(e) {
        if (e.key === 'Enter') {
            clearTimeout(searchTimer);
            table.search($(this).val().trim()).draw();
        }
    });
    $('#clientSearchClear').on('click', function() {
        $('#clientSearch').val('');
        table.search('').draw();
    });

    // Reload when project or bh_status changes (keeps your earlier inline onchange)
    $('#projectFilter, #bhStatusFilter').on('change', function() {
        table.ajax.reload();
    });

    // Ctrl+P shortcut to trigger DataTable print
    $(document).on('keydown', function(e) {
        if (e.ctrlKey && e.key.toLowerCase() === 'p') {
            e.preventDefault(); // prevent browser default print
            if (typeof table.buttons === 'function') {
                table.button('.buttons-print').trigger(); // trigger the print button
            } else {
                window.print(); // fallback
            }
        }
    });
});
