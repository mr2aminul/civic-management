<script>
document.addEventListener('DOMContentLoaded', function() {
  const tab = document.getElementById('tab_client_list');
  if (!tab) return;

  tab.addEventListener('show.bs.tab', function() {
    loadClientsList();
  });

  document.getElementById('btn_client_filter').addEventListener('click', function() {
    const panel = document.getElementById('client_filter_panel');
    panel.style.display = panel.style.display === 'none' ? 'grid' : 'none';
  });

  document.getElementById('btn_client_apply_filter').addEventListener('click', function() {
    loadClientsList({
      name: document.getElementById('client_filter_name').value,
      project: document.getElementById('client_filter_project').value,
      status: document.getElementById('client_filter_status').value
    });
  });

  document.getElementById('btn_client_reset_filter').addEventListener('click', function() {
    document.getElementById('client_filter_name').value = '';
    document.getElementById('client_filter_project').value = '';
    document.getElementById('client_filter_status').value = '';
    loadClientsList();
  });

  function loadClientsList(filters = {}) {
    fetch('/xhr/manage_clients.php?f=manage_clients&s=search_clients', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        q: filters.name || '',
        project_id: filters.project || '',
        bh_status: filters.status || 'all'
      })
    })
    .then(r => r.json())
    .then(data => {
      renderClientsList(data);
    })
    .catch(e => console.error('[v0] Error loading clients:', e));
  }

  function renderClientsList(clients) {
    const tbody = document.getElementById('clients_list_tbody');
    tbody.innerHTML = '';
    
    if (!clients || clients.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No clients found</td></tr>';
      return;
    }

    document.getElementById('client_total_count').textContent = clients.length;

    clients.forEach(client => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><strong>${client.id}</strong></td>
        <td>${client.name}</td>
        <td>${client.phone}</td>
        <td>${client.nid || '-'}</td>
        <td>${client.projects || '-'}</td>
        <td>${client.plots || '0'}</td>
        <td class="text-danger">৳${(client.total_due || 0).toLocaleString('en-US', {maximumFractionDigits: 2})}</td>
        <td>
          <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-info" onclick="viewClient(${client.id})" title="View">
              <i class="lni lni-eye"></i>
            </button>
            <button class="btn btn-outline-warning" onclick="editClient(${client.id})" title="Edit">
              <i class="lni lni-pencil"></i>
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(row);
    });
  }
});
</script>
