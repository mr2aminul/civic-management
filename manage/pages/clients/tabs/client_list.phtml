    <div class="card-body p-3">
      <!-- Filter Panel -->
      <div id="client_filter_panel" class="row mb-3" style="display:none;">
        <div class="col-md-3">
          <input type="text" class="form-control form-control-sm" id="client_filter_name" placeholder="Client name">
        </div>
        <div class="col-md-2">
          <select class="form-select form-select-sm" id="client_filter_project">
            <option value="">All Projects</option>
