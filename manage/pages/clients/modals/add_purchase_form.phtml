<script>
$(document).ready(function() {
    // Initialize Select2 for purchase/booking selection
    $('#purchaseBooking').select2({
        placeholder: 'Search plots...',
        allowClear: true,
        ajax: {
            url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=search_purchases',
            dataType: 'json',
            delay: 300,
            data: function(params) {
                return {
                    q: params.term,
                    project_id: $('#purchaseProject').val(),
                    page: params.page || 1,
                    per_page: 30
                };
            },
            processResults: function(data) {
                return {
                    results: data.results || [],
                    pagination: { more: data.more || false }
                };
            }
        },
        templateResult: function(item) {
            if (!item.id) return item.text;
            let badge = '<span class="badge bg-' + (item.available ? 'success' : 'danger') + '">' + item.status_label + '</span>';
            return $('<span>' + item.text + ' ' + badge + '</span>');
        }
    });

    // Initialize Select2 for client selection
    $('#purchaseClient').select2({
        placeholder: 'Search clients...',
        allowClear: true,
        ajax: {
            url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_all_clients',
            dataType: 'json',
            delay: 300,
            data: function(params) {
                return { q: params.term };
            },
            processResults: function(data) {
                return { results: data || [] };
            }
        }
    });

    // Initialize Select2 for nominees
    $('#purchaseNominees').select2({
        placeholder: 'Select nominees...',
        allowClear: true
    });
});

function loadPlots() {
    const projectId = $('#purchaseProject').val();
    if (!projectId) {
        $('#purchaseBooking').html('<option value="">Select project first</option>').trigger('change');
        return;
    }
    // Select2 will handle loading via AJAX
}

function loadPurchaseDetails() {
    const purchaseId = $('#purchaseBooking').val();
    if (!purchaseId) return;

    // Get purchase details to populate katha
    $.ajax({
        url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_purchase_by_id',
        type: 'GET',
        data: { id: purchaseId },
        dataType: 'json',
        success: function(resp) {
            if (resp.status === 200 && resp.item) {
                const item = resp.item;
                $('#purchaseTotalKatha').val(item.katha || 0);
                calculateTotalPrice();
                
                // Show conflict warning if not available
                if (!item.available) {
                    $('#purchaseConflictAlert').html(
                        '<strong>⚠️ Warning:</strong> This plot may have active bookings. ' +
                        'Check "Force override" to proceed.'
                    ).show();
                } else {
                    $('#purchaseConflictAlert').hide();
                }
            }
        }
    });
}

function calculateTotalPrice() {
    const perKatha = parseFloat($('#purchasePerKatha').val()) || 0;
    const totalKatha = parseFloat($('#purchaseTotalKatha').val()) || 0;
    const downPayment = parseFloat($('#purchaseDownPayment').val()) || 0;
    const bookingMoney = parseFloat($('#purchaseBookingMoney').val()) || 0;

    const totalPrice = perKatha * totalKatha;
    const totalAdvance = downPayment + bookingMoney;
    const remaining = totalPrice - totalAdvance;

    $('#purchaseTotalPrice').text('৳' + totalPrice.toLocaleString('en-BD', { minimumFractionDigits: 2 }));
    $('#purchaseTotalAdvance').text('৳' + totalAdvance.toLocaleString('en-BD', { minimumFractionDigits: 2 }));
    $('#purchaseRemaining').text('৳' + Math.max(0, remaining).toLocaleString('en-BD', { minimumFractionDigits: 2 }));

    // Validate advance doesn't exceed total
    if (totalAdvance > totalPrice && totalPrice > 0) {
        $('#purchaseRemaining').css('color', 'red');
        $('#purchaseSubmitBtn').prop('disabled', true);
    } else {
        $('#purchaseRemaining').css('color', 'inherit');
        $('#purchaseSubmitBtn').prop('disabled', false);
    }
}

$('#addPurchaseForm').on('submit', function(e) {
    e.preventDefault();

    const formData = {
        client_id: $('#purchaseClient').val(),
        project_id: $('#purchaseProject').val(),
        purchase_id: $('#purchaseBooking').val(),
        per_katha: $('#purchasePerKatha').val(),
        down_payment: $('#purchaseDownPayment').val(),
        booking_money: $('#purchaseBookingMoney').val(),
        file_num: $('#purchaseFileNum').val(),
        nominee_ids: $('#purchaseNominees').val() ? JSON.stringify($('#purchaseNominees').val()) : '[]',
        force: $('#purchaseForce').is(':checked') ? '1' : '0'
    };

    $.ajax({
        url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=register_purchase',
        type: 'POST',
        data: formData,
        dataType: 'json',
        success: function(resp) {
            if (resp.status === 200) {
                pos5_success_noti(resp.message);
                $('#addPurchaseModal').modal('hide');
                this.form.reset();
                // Refresh the parent data table
                if (typeof DataTableRefresh === 'function') {
                    DataTableRefresh();
                }
            } else {
                pos4_error_noti(resp.message || 'Error registering purchase');
            }
        },
        error: function(xhr, status, error) {
            console.error('AJAX error:', error);
            pos4_error_noti('Error: ' + error);
        }
    });
});
</script>
