<script>
// Global Select2 Focus Fix
$(document).on('select2:open', function(e) {
    var targetId = e.target.id;
    // Only apply if the select2 is inside our modal
    if ($(e.target).closest('#addPurchaseModal').length) {
        window.setTimeout(function () {
            document.querySelector('.select2-container--open .select2-search__field').focus();
        }, 50);
    }
});

// Move modal to body immediately to ensure correct z-index and positioning
$(document).ready(function() {
    // Remove any existing modal with the same ID to prevent duplicates
    $('body > #addPurchaseModal').remove();
    // Move the current modal to body
    $('#addPurchaseModal').appendTo("body");
});

function closeAddPurchaseModal() {
    $('#addPurchaseModal').modal('hide');
}

// Function to reset form and set client context
window.resetAddPurchaseForm = function(clientId = null) {
    var form = $('#addPurchaseForm')[0];
    form.reset();
    $('#addPurchaseForm').removeClass('was-validated');
    
    // Reset Select2s
    $('#purchaseProject').val(null).trigger('change');
    $('#purchaseBooking').val(null).trigger('change').prop('disabled', true);
    $('#purchaseNominees').val(null).trigger('change');
    
    // Clear details
    $('#detailBlock, #detailPlot, #detailRoad, #detailFacing').text('-');
    $('#detailKatha').text('-');
    $('#detailStatus').html('<span class="badge bg-secondary">Unknown</span>');
    $('#purchaseConflictAlert').addClass('d-none');
    
    // Reset Financials
    $('#displayTotalPrice, #displayTotalAdvance, #displayRemainingBalance').text('৳0.00');
    $('#displayRemainingBalance').removeClass('text-danger');
    $('#schedulePreviewSection').hide();
    window.generatedSchedule = null;

    // Handle Client Context
    if (clientId) {
        // Pre-select client and hide selector
        // Since Select2 is AJAX, we need to fetch the client name or just use ID if name unavailable
        // Ideally we pass name too, but if not, we can just set ID and let user see it in view_client
        // Or we can fetch it. For now, assuming view_client context implies we know the client.
        // We will create a dummy option to satisfy Select2 if needed, but since we hide the section, it matters less visually.
        // However, the form submit needs the value.
        
        // If we have the client object in global scope (from view_client), use it.
        // Otherwise, just set the value.
        if ($('#purchaseClient').find("option[value='" + clientId + "']").length) {
            $('#purchaseClient').val(clientId).trigger('change');
        } else {
             // Create a temporary option so val() works
             var newOption = new Option("Selected Client", clientId, true, true);
             $('#purchaseClient').append(newOption).trigger('change');
        }
        
        $('#contextClientId').val(clientId);
        $('#clientSection').hide();
    } else {
        // Clear client and show selector
        $('#purchaseClient').val(null).trigger('change');
        $('#contextClientId').val('');
        $('#clientSection').show();
    }
};

$(document).ready(function() {
    // Initialize Select2
    function initSelect2(selector, placeholder) {
        $(selector).select2({
            theme: 'bootstrap-5',
            dropdownParent: $('#addPurchaseModal'),
            width: '100%',
            placeholder: placeholder,
            allowClear: true
        });
    }

    // Client Select2 with AJAX
    $('#purchaseClient').select2({
        theme: 'bootstrap-5',
        dropdownParent: $('#addPurchaseModal'),
        width: '100%',
        placeholder: 'Search Client...',
        allowClear: true,
        ajax: {
            url: Wo_Ajax_Requests_File() + '?f=manage_clients&s=search_clients',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term
                };
            },
            processResults: function (data) {
                return {
                    results: data
                };
            },
            cache: true
        },
        minimumInputLength: 1
    });

    initSelect2('#purchaseProject', 'Select Project');
    initSelect2('#purchaseNominees', 'Select Nominees');

    // Initialize Plot Selection with Custom Formatting
    $('#purchaseBooking').select2({
        theme: 'bootstrap-5',
        dropdownParent: $('#addPurchaseModal'),
        width: '100%',
        placeholder: 'Search for a plot...',
        allowClear: true,
        ajax: {
            url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=search_purchases',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term, 
                    search: params.term, 
                    project_id: $('#purchaseProject').val() 
                };
            },
            processResults: function (data) {
                var rawResults = data.results || data;
                if (!Array.isArray(rawResults)) rawResults = [];
                
                return {
                    results: rawResults.map(function(item) {
                        return normalizePlotItem(item);
                    })
                };
            },
            cache: true
        },
        minimumInputLength: 0,
        templateResult: select2TemplateResult,
        templateSelection: select2TemplateSelection,
        matcher: advancedMatcher
    });

    // Handle Project Change
    $('#purchaseProject').on('change', function() {
        $('#purchaseBooking').val(null).trigger('change');
        $('#purchaseBooking').prop('disabled', false);
    });

    // Handle Plot Selection
    $('#purchaseBooking').on('select2:select', function(e) {
        var data = e.params.data;
        
        // Populate Details
        $('#detailBlock').text(data.block || '-');
        $('#detailPlot').text(data.plot || '-');
        $('#detailRoad').text(data.road || '-');
        $('#detailFacing').text(data.facing || '-'); 
        $('#detailKatha').text(data.katha || '-');
        $('#detailStatus').html(data.status_label || '<span class="badge bg-secondary">Unknown</span>');

        // Store katha for calculation
        $('#purchaseBooking').data('katha', parseFloat(data.katha) || 0);

        // Check availability
        if (!data.available) { 
            $('#purchaseConflictAlert').removeClass('d-none');
        } else {
            $('#purchaseConflictAlert').addClass('d-none');
        }

        calculateTotalPrice();
    });

    // ---------------------------------------------------------
    // Legacy Helper Functions (Restored)
    // ---------------------------------------------------------

    // Normalize plot data
    function normalizePlotItem(item) {
        if (!item) return null;
        
        var id = item.id || item.purchase_id || '';
        var plot = item.plot || item.plot_number || '';
        var katha = (item.katha !== undefined) ? String(item.katha) : '';
        var block = item.block || item.block_name || '';
        var road = item.road || item.road_name || '';
        var facing = item.facing || '';
        var status = item.status || '';
        var statusLabel = item.status_label || getStatusLabel(status);
        var available = item.available === 1 || item.available === true || item.available === '1';

        // Fallback availability check if 'available' prop missing but status exists
        if (item.available === undefined) {
             available = (status == 0 || status == 1 || status == '0' || status == '1');
        }

        var parts = [];
        if (block) parts.push('Block ' + String(block).toUpperCase());
        if (plot) parts.push('Plot ' + String(plot));
        if (katha) parts.push(String(katha) + ' katha');
        if (road) parts.push('Road ' + String(road));
        if (facing) parts.push('Facing ' + String(facing));

        return {
            id: id,
            text: parts.join(' • ') || String(id),
            plot: plot,
            katha: katha,
            block: block,
            road: road,
            facing: facing,
            status: status,
            status_label: statusLabel,
            available: available,
            blocked: !available,
            raw: item
        };
    }

    function getStatusLabel(status) {
        var s = String(status).toLowerCase();
        if (s === '0' || s === '1' || s === 'available') return 'Available';
        if (s === '2' || s === 'sold' || s === 'booked') return 'Sold';
        if (s === '3' || s === 'complete') return 'Complete';
        if (s === '4' || s.indexOf('cancel') !== -1) return 'Cancelled';
        return s ? (s.charAt(0).toUpperCase() + s.slice(1)) : '';
    }

    // Enhanced template functions
    function select2TemplateResult(item) {
        if (!item || !item.id) return item && item.text ? item.text : null;
        
        var $wrap = $('<div class="select2-result-item d-flex justify-content-between align-items-center"></div>');
        var $label = $('<div class="select2-main-text flex-grow-1"></div>').text(item.text);
        $wrap.append($label);

        if (item.status_label) {
            var badgeClass = getBadgeClass(item.status);
            var $badge = $('<span class="select2-result-badge ' + badgeClass + '"></span>').text(item.status_label);
            $wrap.append($badge);
        }

        if (item.blocked) {
            $wrap.addClass('select2-result--disabled');
            $label.append(' <small class="text-muted">(Not Available)</small>');
        }

        return $wrap;
    }

    function select2TemplateSelection(item) {
        if (!item || !item.id) return item && item.text ? item.text : null;
        return item.text;
    }

    function getBadgeClass(status) {
        var s = String(status || '').toLowerCase();
        if (/(sold|2|booked)/.test(s)) return 'sold';
        if (/(cancel|4)/.test(s)) return 'cancelled';
        if (/(complete|3)/.test(s)) return 'completed';
        if (/(available|0|1)/.test(s)) return 'available';
        return 'other';
    }

    // Advanced matcher for intelligent search
    function advancedMatcher(params, data) {
        if (!params || !params.term) return data;

        var term = params.term.toLowerCase().trim();
        var searchable = [
            data.text || '',
            data.block || '',
            data.plot || '',
            data.katha || '',
            data.road || '',
            data.facing || '',
            data.status_label || ''
        ].join(' ').toLowerCase();

        if (searchable.indexOf(term) !== -1) return data;

        var patterns = [
            /(\d+)\s*k/i,
            /r(\d+)/i,
            /p(\d+)/i,
            /b([a-z])/i
        ];

        for (var i = 0; i < patterns.length; i++) {
            var match = term.match(patterns[i]);
            if (match && searchable.indexOf(match[1]) !== -1) return data;
        }

        return null;
    }

    // Utility functions
    function formatCurrencyNumber(n) {
        if (isNaN(n) || n === null) return '৳0';
        return '৳' + Number(Math.round(n * 10) / 10).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 1
        });
    }

    // Handle Client Selection (Load Nominees)
    $('#purchaseClient').on('change', function() {
        var clientId = $(this).val();
        if (clientId) {
            $.get(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_nominees', {client_id: clientId}, function(data) {
                var nominees = $('#purchaseNominees');
                nominees.empty();
                if (data.status == 200) {
                    $.each(data.nominees, function(index, nominee) {
                        nominees.append(new Option(nominee.name + ' (' + nominee.relation + ')', nominee.id));
                    });
                }
            });
        }
    });

    // Financial Calculations
    function calculateTotalPrice() {
        var katha = parseFloat($('#purchaseBooking').data('katha')) || 0;
        var perKatha = parseFloat($('#purchasePerKatha').val()) || 0;
        var bookingMoney = parseFloat($('#purchaseBookingMoney').val()) || 0;
        var downPayment = parseFloat($('#purchaseDownPayment').val()) || 0;

        var totalPrice = katha * perKatha;
        var totalAdvance = bookingMoney + downPayment;
        var remaining = totalPrice - totalAdvance;

        $('#displayTotalPrice').text('৳' + totalPrice.toLocaleString('en-BD', {minimumFractionDigits: 2}));
        $('#displayTotalAdvance').text('৳' + totalAdvance.toLocaleString('en-BD', {minimumFractionDigits: 2}));
        $('#displayRemainingBalance').text('৳' + remaining.toLocaleString('en-BD', {minimumFractionDigits: 2}));
        
        if (remaining < 0) {
            $('#displayRemainingBalance').addClass('text-danger');
        } else {
            $('#displayRemainingBalance').removeClass('text-danger');
        }
    }

    $('#purchasePerKatha, #purchaseBookingMoney, #purchaseDownPayment').on('input', calculateTotalPrice);

    // Payment Mode Change Handlerfn
    $('input[name="payment_mode"]').on('change', function() {
        var mode = $(this).val();
        if (mode === '1') {
            // Full Payment - hide installment fields
            $('#installmentFields').hide();
        } else {
            // Installment - show all fields
            $('#installmentFields').show();
        }
    });
    // Trigger initial state
    $('input[name="payment_mode"]:checked').trigger('change');

    // Schedule Preview - Client-side Generation (matching payment_schedule_modal.phtml)
    $('#previewScheduleBtn').on('click', function() {
        var katha = parseFloat($('#purchaseBooking').data('katha')) || 0;
        var perKatha = parseFloat($('#purchasePerKatha').val()) || 0;
        var totalPrice = katha * perKatha;
        var bookingMoney = parseFloat($('#purchaseBookingMoney').val()) || 0;
        var downPayment = parseFloat($('#purchaseDownPayment').val()) || 0;
        var remaining = totalPrice - (bookingMoney + downPayment);

        if (remaining <= 0) {
            alert('Remaining balance must be greater than 0 to generate a schedule.');
            return;
        }

        var mode = $('input[name="payment_mode"]:checked').val();
        var schedule = [];

        // Always add booking money and down payment rows if they exist
        if (bookingMoney > 0) {
            schedule.push({
                installment_number: 'B',
                particular: 'Booking Money',
                due_date: new Date().toISOString().slice(0,10),
                installment_amount: bookingMoney
            });
        }
        if (downPayment > 0) {
            schedule.push({
                installment_number: 'D',
                particular: 'Down Payment',
                due_date: new Date().toISOString().slice(0,10),
                installment_amount: downPayment
            });
        }

        if (mode === '1') {
            // Full Payment Mode
            var startDate = $('#installmentStartDate').val() || new Date().toISOString().slice(0,10);
            schedule.push({
                installment_number: 'Full',
                particular: 'Full Payment',
                due_date: startDate,
                installment_amount: remaining
            });
        } else {
            // Installment Mode - Match payment_schedule_modal.phtml logic
            var installments = parseInt($('#installmentsCount').val() || 60);
            var adjustmentType = $('#adjustmentType').val() || 'year_end';
            var monthlyInput = parseInt($('#monthlyAmount').val() || 0);
            var yearlyAdjustment = parseInt($('#yearlyAdjustment').val() || 0);
            var startDate = $('#installmentStartDate').val() || new Date().toISOString().slice(0,10);
            var startOption = $('#startOption').val() || 'exact';

            // Calculate adjustment months
            var years = Math.ceil(installments / 12);
            var adjMonths = [];
            var totalAdjSum = 0;

            if (yearlyAdjustment > 0 && adjustmentType !== 'custom') {
                if (adjustmentType === 'year_quarterly') {
                    for (var y = 0; y < years; y++) {
                        [2, 5, 8, 11].forEach(function(off) {
                            var idx = y * 12 + off;
                            if (idx < installments) {
                                adjMonths.push(idx);
                                totalAdjSum += yearlyAdjustment;
                            }
                        });
                    }
                } else {
                    for (var y = 0; y < years; y++) {
                        var idx = 0;
                        if (adjustmentType === 'year_start') idx = y * 12;
                        else if (adjustmentType === 'year_middle') idx = y * 12 + 6;
                        else idx = y * 12 + 11; // year_end
                        if (idx < installments) {
                            adjMonths.push(idx);
                            totalAdjSum += yearlyAdjustment;
                        }
                    }
                }
            }

            // Calculate monthly amount
            var remainingAfterAdj = remaining - totalAdjSum;
            if (remainingAfterAdj < 0) remainingAfterAdj = 0;
            var regularCount = installments - adjMonths.length;
            if (regularCount < 0) regularCount = 0;
            var monthlyAmount = monthlyInput > 0 ? monthlyInput : (regularCount > 0 ? Math.floor(remainingAfterAdj / regularCount) : 0);

            // Build amounts array
            var amounts = new Array(installments).fill(0);
            adjMonths.forEach(function(mi) { amounts[mi] = yearlyAdjustment; });
            for (var i = 0; i < installments; i++) {
                if (amounts[i] === 0) amounts[i] = monthlyAmount;
            }

            // Distribute remainder
            var baseSum = amounts.reduce(function(s,v) { return s + v; }, 0);
            var diff = remaining - baseSum;
            if (diff !== 0) {
                var distributeIdxs = [];
                for (var k = 0; k < installments; k++) {
                    if (adjMonths.indexOf(k) === -1) distributeIdxs.push(k);
                }
                if (distributeIdxs.length === 0) {
                    for (var k2 = 0; k2 < installments; k2++) distributeIdxs.push(k2);
                }
                var sign = diff > 0 ? 1 : -1;
                var left = Math.abs(diff);
                var j = 0;
                while (left > 0) {
                    var target = distributeIdxs[j % distributeIdxs.length];
                    amounts[target] += sign;
                    left--;
                    j++;
                }
            }

            // Generate schedule rows
            var cd = new Date(startDate);
            if (isNaN(cd.getTime())) cd = new Date();
            if (startOption === 'start') cd.setDate(1);
            else if (startOption === 'middle') cd.setDate(15);
            else if (startOption === 'end') cd.setDate(new Date(cd.getFullYear(), cd.getMonth() + 1, 0).getDate());

            for (var idx = 0; idx < installments; idx++) {
                var isAdj = adjMonths.indexOf(idx) !== -1;
                var amt = amounts[idx];
                var label = (idx === 0 ? '1st Installment' : (idx + 1) + 'th Installment');
                var dueDate = cd.getFullYear() + '-' + ('0' + (cd.getMonth() + 1)).slice(-2) + '-' + ('0' + cd.getDate()).slice(-2);
                
                schedule.push({
                    installment_number: idx + 1,
                    particular: label + (isAdj ? ' (Yearly Adjustment)' : ''),
                    due_date: dueDate,
                    installment_amount: amt
                });
                
                cd.setMonth(cd.getMonth() + 1);
            }

            // Final adjustment to match total exactly
            var sumAll = schedule.reduce(function(s, r) { return s + parseInt(r.installment_amount); }, 0);
            var totalDiff = remaining - sumAll;
            if (totalDiff !== 0 && schedule.length > 0) {
                schedule[schedule.length - 1].installment_amount = parseInt(schedule[schedule.length - 1].installment_amount) + totalDiff;
            }
        }

        window.generatedSchedule = schedule;
        renderSchedulePreview(schedule);
    });

    function renderSchedulePreview(schedule) {
        var tbody = $('#schedulePreviewTable tbody');
        tbody.empty();
        $('#previewTotalInstallments').text(schedule.length + ' Installments');
        
        schedule.forEach(function(item) {
            tbody.append(`
                <tr>
                    <td>${item.installment_number}</td>
                    <td>${item.particular}</td>
                    <td>${item.due_date}</td>
                    <td>৳${parseFloat(item.installment_amount).toLocaleString('en-BD')}</td>
                </tr>
            `);
        });
        
        $('#schedulePreviewSection').show();
    }

    // Check plot booking status
    function checkPlotBooking(plotId, projectId, callback) {
        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=check_plot_booking', {
            purchase_id: plotId,
            project_id: projectId
        })
        .done(function(response){
            var data = typeof response === 'string' ? JSON.parse(response) : response;
            callback(data);
        })
        .fail(function(){
            callback({ status: 500, message: 'Server error while checking plot availability' });
        });
    }

    // Save Purchase
    $('#savePurchaseBtn').on('click', function() {
        var form = $('#addPurchaseForm')[0];
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        // Build payload object
        var payload = {
            client_id: $('#purchaseClient').val(),
            purchase_id: $('#purchaseBooking').val(),
            project_id: $('#purchaseProject').val(),
            file_num: $('#purchaseFileNum').val(),
            nominee_ids: $('#purchaseNominees').val(),
            per_katha: $('#purchasePerKatha').val(),
            booking_money: $('#purchaseBookingMoney').val(),
            down_payment: $('#purchaseDownPayment').val(),
            payment_mode: $('input[name="payment_mode"]:checked').val(),
            installments: $('#installmentsCount').val(),
            adjustment_type: $('#adjustmentType').val(),
            monthly_amount: $('#monthlyAmount').val(),
            yearly_adjustment: $('#yearlyAdjustment').val(),
            start_date: $('#installmentStartDate').val(),
            start_option: $('#startOption').val(),
            interest_percent: $('#interestPercent').val()
        };

        // Add schedule if generated
        if (window.generatedSchedule) {
            payload.schedule = JSON.stringify(window.generatedSchedule);
        }

        $('#savePurchaseBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');

        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=register_purchase', payload)
            .done(function(response){
                var data = typeof response === 'string' ? JSON.parse(response) : response;
                
                if (data.status === 200) {
                    alert('Purchase added successfully!');
                    location.reload();
                } else if (data.status === 409) {
                    if (confirm(data.message + '\n\nDo you want to force assign this plot?')) {
                        payload.force = 1;
                        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=register_purchase', payload)
                            .done(function(response2){
                                var data2 = typeof response2 === 'string' ? JSON.parse(response2) : response2;
                                if (data2.status === 200) {
                                    alert('Purchase added successfully!');
                                    location.reload();
                                } else {
                                    alert(data2.message || 'Failed to force assign plot.');
                                    $('#savePurchaseBtn').prop('disabled', false).html('<i class="lni lni-checkmark-circle me-2"></i> Confirm Purchase');
                                }
                            })
                            .fail(function(){
                                alert('Server error occurred while forcing assignment.');
                                $('#savePurchaseBtn').prop('disabled', false).html('<i class="lni lni-checkmark-circle me-2"></i> Confirm Purchase');
                            });
                    } else {
                        $('#savePurchaseBtn').prop('disabled', false).html('<i class="lni lni-checkmark-circle me-2"></i> Confirm Purchase');
                    }
                } else {
                    alert(data.message || 'Failed to add purchase.');
                    $('#savePurchaseBtn').prop('disabled', false).html('<i class="lni lni-checkmark-circle me-2"></i> Confirm Purchase');
                }
            })
            .fail(function(){
                alert('Server error while adding purchase.');
                $('#savePurchaseBtn').prop('disabled', false).html('<i class="lni lni-checkmark-circle me-2"></i> Confirm Purchase');
            });
    });
});
</script>
