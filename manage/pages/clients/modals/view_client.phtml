// Pre-calculate purchase counts per project for merge logic
$project_counts = [];
$client_purchases = []; // Array to store all purchases for JS
if (isset($wo['booking_helper']) && !empty($wo['booking_helper'])) {
    foreach ($wo['booking_helper'] as $bh) {
        if (!empty($bh['booking_id'])) {
            $b_info = $db->where('id', $bh['booking_id'])->getOne('wo_booking', ['project']);
            if ($b_info && !empty($b_info->project)) {
                $p_name = $b_info->project;
                if (!isset($project_counts[$p_name])) $project_counts[$p_name] = 0;
                $project_counts[$p_name]++;
            }
        }
    }
}

if (isset($wo['booking_helper']) && !empty($wo['booking_helper'])) {
    foreach ($wo['booking_helper'] as $index => $bh) {
        $purchase_id = $bh['id'];
        $is_cancelled = ($bh['status'] == 4);
        
        // Fetch Booking Details
        $booking = [];
        $proj_html = 'N/A';
        $current_project_name = '';
        if (!empty($bh['booking_id'])) {
            $booking_obj = $db->where('id', $bh['booking_id'])->getOne('wo_booking');
            if ($booking_obj) {
                // Convert object to array for easier usage if needed, or use object syntax
                $booking = (array)$booking_obj; 
                $proj_html = htmlspecialchars(ucwords(str_replace('-', ' ', $booking['project'])), ENT_QUOTES);
                $current_project_name = $booking['project'];
            }
        }

        // Fetch Nominees
        $nominee_ids = [];
        $raw_nom_ids = $bh['nominee_ids'] ?? ($booking['nominee_ids'] ?? null);
        if (!empty($raw_nom_ids)) {
            $decoded = json_decode($raw_nom_ids, true);
            if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                $nominee_ids = array_map('intval', $decoded);
            } else {
                $s = trim((string)$raw_nom_ids, "[] \t\n\r\0\x0B");
                if ($s !== '') {
                    $sep = (strpos($s, '|') !== false) ? '|' : ',';
                    $nominee_ids = array_map('intval', array_filter(explode($sep, $s)));
                }
            }
        }
        
        $i_nominee = [];
        $ii_nominee = [];
        if (!empty($nominee_ids)) {
            $rows = $db->where('id', $nominee_ids, 'IN')->get('crm_nominees', null, 'id, name, address, birthday, share_parcent, relation, phone');
            $rows_by_id = [];
            foreach ($rows as $r) $rows_by_id[(int)$r->id] = (array)$r; // Convert to array here
            
            $count = 0;
            foreach ($nominee_ids as $nid) {
                if (!isset($rows_by_id[$nid])) continue;
                if ($count === 0) $i_nominee = $rows_by_id[$nid];
                elseif ($count === 1) $ii_nominee = $rows_by_id[$nid];
                $count++;
            }
        }
        
        // Transfer History
        $transfer_history = [];
        $latest_transfer = null;
        try {
            $transfers = $db->where('original_purchase_id', $purchase_id)->orderBy('transfer_date', 'DESC')->get('crm_purchase_transfer_history');
            if (!empty($transfers)) {
                $transfer_history = $transfers;
                $latest_transfer = $transfers[0];
            }
        } catch (Exception $e) {}
        
        // Installments (for print form)
        $installments = [];
        $rawInst = $bh['installment'] ?? ($booking['installments'] ?? null);
        if (!empty($rawInst)) {
            $dec = json_decode($rawInst, true);
            if (json_last_error() === JSON_ERROR_NONE) $installments = (array)$dec;
        }

        // --- 2. Generate Hidden Print Form ---
        echo Wo_LoadManagePage('clients/booking_form_template', [
            'p' => $bh,
            'index' => $index,
            'client' => $wo['client'], // Use the main client data
            'booking' => $booking,
            'proj_html' => $proj_html,
            'i_nominee' => $i_nominee,
            'ii_nominee' => $ii_nominee,
            'installments' => $installments
        ]);

        // --- 3. Metrics Calculation ---
        // 1. Get Real-time Payment Data from crm_payment_schedule
        $payment_stats = $db->where('purchase_id', $purchase_id)->where('status', '99', '!=')->getOne('crm_payment_schedule', 'SUM(installment_amount) as total_amount, SUM(paid_amount) as total_paid, COUNT(*) as total_installments');
        $pending_count = $db->where('purchase_id', $purchase_id)->where('status', 0)->getValue('crm_payment_schedule', 'count(*)');
        $overdue_count = $db->where('purchase_id', $purchase_id)->where('status', 3)->getValue('crm_payment_schedule', 'count(*)');
        
        // New Advanced Metrics
        // Late Payments: Based on late_fee_amount (Interest)
        // User Rule: "Late Payment History are actually interest basis"
        // We sum late_fee_amount where it is > 0
        $late_stats = $db->where('purchase_id', $purchase_id)
                     ->where('late_fee_amount', 0, '>')
                     ->getOne('crm_payment_schedule', 'SUM(late_fee_amount) as total_late_fee, COUNT(*) as late_count');

        // --- 4. Pending Change Status Fetching ---
        $pending_status = null;
        $pending_details = [];
        
        // Check Merge Requests
        if ($db->tableExists('crm_merge_requests')) {
            $merge = $db->where('source_purchase_id', $purchase_id)
                        ->orWhere('target_purchase_id', $purchase_id)
                        ->orderBy('created_at', 'DESC')
                        ->getOne('crm_merge_requests');
            if ($merge) {
                if ($merge->approval_status == 'pending') {
                    $pending_status = 'merge_pending';
                    $pending_details = ['type' => 'Merge', 'date' => $merge->created_at];
                } elseif ($merge->approval_status == 'rejected' && strtotime($merge->updated_at) > strtotime('-7 days')) {
                    $pending_status = 'merge_rejected';
                    $pending_details = ['type' => 'Merge', 'reason' => $merge->rejection_reason, 'date' => $merge->updated_at];
                } elseif ($merge->approval_status == 'approved' && strtotime($merge->updated_at) > strtotime('-7 days')) {
                    $pending_status = 'merge_approved';
                    $pending_details = ['type' => 'Merge', 'date' => $merge->updated_at];
                }
            }
        }

        // Check Transfer History (if no merge pending)
        if (!$pending_status && $db->tableExists('crm_transfer_history')) {
            $transfer = $db->where('purchase_id', $purchase_id)
                           ->orderBy('created_at', 'DESC')
                           ->getOne('crm_transfer_history');
            if ($transfer) {
                $t_type = ucwords(str_replace('_', ' ', $transfer->transfer_type ?? 'Transfer'));
                if ($transfer->status == 'pending') {
                    $pending_status = 'transfer_pending';
                    $pending_details = ['type' => $t_type, 'date' => $transfer->created_at];
                } elseif ($transfer->status == 'denied' && strtotime($transfer->updated_at) > strtotime('-7 days')) {
                    $pending_status = 'transfer_rejected';
                    $pending_details = ['type' => $t_type, 'reason' => $transfer->rejection_reason ?? 'No reason', 'date' => $transfer->updated_at];
                }
            }
        }

        // Check Generic Pending Changes (Reschedule etc)
        if (!$pending_status && $db->tableExists('crm_pending_changes')) {
            $change = $db->where('purchase_id', $purchase_id)
                         ->orderBy('created_at', 'DESC')
                         ->getOne('crm_pending_changes');
            if ($change) {
                $c_type = ucwords(str_replace('_', ' ', $change->change_type));
                if ($change->status == 'pending') {
                    $pending_status = $change->change_type . '_pending';
                    $pending_details = ['type' => $c_type, 'date' => $change->created_at];
                } elseif ($change->status == 'denied' && strtotime($change->updated_at) > strtotime('-7 days')) {
                    $pending_status = $change->change_type . '_rejected';
                    $pending_details = ['type' => $c_type, 'reason' => $change->reason ?? 'No reason', 'date' => $change->updated_at];
                }
            }
        }

        
        $late_count = $late_stats->count ?? 0;
        $late_value = $late_stats->total_late_fee ?? 0;

        // Overdue Value: Due date passed and not fully paid
        // We can sum (installment_amount - paid_amount) for overdue rows
        // Or use overdue_fee_amount if that's what user implies, but usually "Overdue Value" means the principal overdue.
        // User said: "over dues value (from last paid to this month) also if some installment has overdues or partially paid, that also will be count."
        // So it is the remaining balance of overdue installments.
        $overdue_stats = $db->where('purchase_id', $purchase_id)
                            ->where('due_date < CURDATE()')
                            ->where('status', 1, '!=') // Not fully paid
                            ->getOne('crm_payment_schedule', 'COUNT(*) as count, SUM(installment_amount - paid_amount) as total_due');
        
        $overdue_metric_count = $overdue_stats->count ?? 0;
        $overdue_value = $overdue_stats->total_due ?? 0;

        // Basic amounts
        $booking_money = floatval($bh['booking_money'] ?? 0);
        $down_payment = floatval($bh['down_payment'] ?? 0);
        $booking_paid = !empty($bh['booking_payment_date']);
        $down_paid = !empty($bh['down_payment_date']);
        
        // Grand Totals
        $total_installments_amount = floatval($payment_stats->total_amount ?? 0);
        $total_installments_paid = floatval($payment_stats->total_paid ?? 0);
        
        $grand_total = $booking_money + $down_payment + $total_installments_amount;
        $total_paid_overall = $total_installments_paid + ($booking_paid ? $booking_money : 0) + ($down_paid ? $down_payment : 0);
        $remaining = $grand_total - $total_paid_overall;
