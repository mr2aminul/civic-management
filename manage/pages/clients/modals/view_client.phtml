/* view_client.phtml - Complete client view with enhanced payment schedule functionality */
Global $project_mapping;
global $db, $wo;

ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

// Fetch users
$get_users = $db->orderBy('position', 'ASC')->where('active', '1')->where('banned', '0')->get(T_USERS);

// Helper function for refund summary
if (!function_exists('get_refund_summary_v2')) {
    function get_refund_summary_v2($purchase_id) {
        global $db;
        $summary = $db->where('purchase_id', $purchase_id)->getOne('crm_refund_schedule');
        if ($summary) {
            // Calculate total refunded from transactions if needed, or use column if exists
            // For now, assuming columns exist as per usage
            return [
                'total_paid_amount' => $summary['total_paid_amount'] ?? 0,
                'deduction_amount' => $summary['deduction_amount'] ?? 0,
                'refundable_amount' => $summary['refundable_amount'] ?? 0,
                'total_refunded' => $summary['total_refunded'] ?? 0
            ];
        }
        return null;
    }
}

// Totals - Fixed calculations
$clientId = $wo['client']['id'];

// Fixed total amount calculation
$total_amount = 0;
$total_purchase = 0;
try {
    $helpers = $db->rawQuery("
        SELECT bh.per_katha, b.katha 
        FROM `wo_booking_helper` bh
        JOIN `wo_booking` b ON b.id = bh.booking_id
        WHERE bh.client_id = ? AND bh.status != '4'
    ", [$clientId]);
    
    foreach ($helpers as $helper) {
        $per_katha = (float)($helper->per_katha ?? 0);
        $katha = (float)($helper->katha ?? 0);
        $total_amount += ($per_katha * $katha);
        $total_purchase++;
    }
} catch (Exception $e) {
    $total_amount = 0;
    $total_purchase = 0;
}

$total_paid    = (float) $db->where('client_id', $clientId)->getValue('crm_invoices', 'SUM(paid_amount)') ?: 0;
$total_due     = $total_amount - $total_paid;
$total_invoice = (int)   $db->where('client_id', $clientId)->getValue('crm_invoices', 'COUNT(*)');

$get_nominees = $db->where('customer_id', $clientId)->orderBy('name', 'ASC')->get(T_CRM_NOMINEES);
?>

