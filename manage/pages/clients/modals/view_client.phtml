<!-- Core JavaScript for View Client -->
<script>
jQuery(function($){
  'use strict';

  /* ========== Preview XLSX (AJAX) ========== */
  function previewXlsx(purchaseId){
    if (!purchaseId){ alert('Purchase ID missing'); return; }
    // Prepare payload and call save_schedule_xlsx with preview flag (server should support preview:1)
    var $btn = $('#ui_preview_xlsx');
    $btn.prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Preparing...');

    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=installment_excel_modal', { purchase_id: purchaseId })
      .done(function(resp){
        var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
        if (data.status === 200) {
          $('body').append(data.html);
          $('#installmentExcelModal').modal('show');
        } else alert('Failed to open modal');
      })
    .fail(function(){ alert('Server error while preparing preview'); })
    .always(function(){ $btn.prop('disabled', false).html('<i class="lni lni-eye me-1"></i>Preview XLSX'); });
  }
  
  // Core utilities
  function moneyVal(v){
    if (v === undefined || v === null) return 0;
    var s = String(v).replace(/,/g,'').trim();
    if (s === '') return 0;
    var n = Number(s);
    return isNaN(n) ? 0 : n;
  }

  function fmtMoney(v){
    if (v === undefined || v === null) v = 0;
    return Number(Math.round(v * 100) / 100).toLocaleString('en-US', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2
    });
  }

  // Initialize modal components when modal opens
  $('#viewClient-modal').on('shown.bs.modal', function(){
    // Initialize all components
    if (typeof initViewClientComponents === 'function') {
      initViewClientComponents();
    }

    // Initialize transfer history toggle
    initTransferHistoryToggle();
  });

  // Transfer History Toggle Function
  function initTransferHistoryToggle() {
    $(document).off('click.transferHistory', '.toggle-history').on('click.transferHistory', '.toggle-history', function(e){
      e.preventDefault();
      e.stopPropagation();

      var purchaseId = $(this).data('id');
      if (!purchaseId) return;

      var $historyRow = $('#transferHistoryRow_' + purchaseId);
      var $btn = $(this);

      if ($historyRow.is(':visible')) {
        // Hide history
        $historyRow.fadeOut(200);
        $btn.find('i').removeClass('lni-chevron-up').addClass('lni-chevron-down');
        if ($btn.hasClass('badge')) {
          $btn.html('<i class="lni lni-eye"></i> View History (' + $btn.text().match(/\d+/)[0] + ')');
        } else {
          $btn.html('<i class="lni lni-chevron-down"></i> Show');
        }
      } else {
        // Show history
        $historyRow.fadeIn(300);
        $btn.find('i').removeClass('lni-chevron-down').addClass('lni-chevron-up');
        if ($btn.hasClass('badge')) {
          $btn.html('<i class="lni lni-eye-slash"></i> Hide History (' + $btn.text().match(/\d+/)[0] + ')');
        } else {
          $btn.html('<i class="lni lni-chevron-up"></i> Hide');
        }

        // Smooth scroll to history row
        setTimeout(function() {
          $('html, body').animate({
            scrollTop: $historyRow.offset().top - 100
          }, 300);
        }, 100);
      }
    });
  }

  // Cleanup when modal closes - self remove all bindings
  $('#viewClient-modal').on('hidden.bs.modal', function(){
    // Destroy all Select2 instances
    $('#viewClient-modal').find('.select2-hidden-accessible').each(function(){
      try {
        $(this).select2('destroy');
      } catch(e) {}
    });
    
    // Remove all event handlers bound to window
    $(window).off('.viewClient');
    $(document).off('.viewClient');
    
    // Clear any intervals or timeouts
    if (window.viewClientIntervals) {
      window.viewClientIntervals.forEach(function(id) {
        clearInterval(id);
      });
      window.viewClientIntervals = [];
    }
    
    if (window.viewClientTimeouts) {
      window.viewClientTimeouts.forEach(function(id) {
        clearTimeout(id);
      });
      window.viewClientTimeouts = [];
    }
    
    // Clean up global functions
    delete window.transferPurchase;
    delete window.generatePurchaseReport;
    delete window.exportPurchaseData;
    delete window.suspendPurchase;
    delete window.initViewClientComponents;
    delete window.openPaymentSchedule;
    delete window.changePlot;
    delete window.printPaymentSchedule;
    delete window.togglePayment;
    
    //Clean up the code
    $('.self_remove_on_close').remove();
  });


  // Wire #printButton to print ALL booking forms in this modal
  $('#printButton').off('click').on('click', function(){
    var ids = [];
    $('#viewClient-modal .print_area').each(function(){
      var id = $(this).attr('data-purchase-id');
      if (id) ids.push(id);
    });
    if (!ids.length) {
      alert('No booking forms available to print.');
      return;
    }
    printBookingFormsByIds(ids);
  });

  // Wire #printButton to print ALL booking forms in this modal
  $('.print_installment').off('click').on('click', function(){
      var id = $(this).attr('data-id');
        previewXlsx(id);
  });

  // Wire individual print button(s)
  $(document).off('click', '.print-booking-form').on('click', '.print-booking-form', function(e){
    e.preventDefault();
    var id = $(this).data('id');
    if (!id) { alert('Booking id missing'); return; }
    printBookingFormsByIds([id]);
  });

  // Global functions for dropdown actions
  window.generatePurchaseReport = function(purchaseId) {
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=generate_purchase_report', {
      purchase_id: purchaseId
    })
    .done(function(response){
      var data = typeof response === 'string' ? JSON.parse(response) : response;
      if (data && data.status === 200 && data.download_url) {
        window.open(data.download_url, '_blank');
      } else {
        alert(data.message || 'Failed to generate report');
      }
    })
    .fail(function(){
      alert('Server error while generating report');
    });
  };

  window.exportPurchaseData = function(purchaseId) {
    var format = prompt('Export format:\n1. Excel\n2. PDF\n3. CSV', '1');
    if (!format) return;
    
    var formatMap = {'1': 'excel', '2': 'pdf', '3': 'csv'};
    var exportFormat = formatMap[format] || 'excel';
    
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=export_purchase_data', {
      purchase_id: purchaseId,
      export_type: exportFormat
    })
    .done(function(response){
      var data = typeof response === 'string' ? JSON.parse(response) : response;
      if (data && data.status === 200 && data.download_url) {
        var link = document.createElement('a');
        link.href = data.download_url;
        link.download = data.filename || 'purchase_data.' + exportFormat;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } else {
        alert(data.message || 'Failed to export data');
      }
    })
    .fail(function(){
      alert('Server error while exporting data');
    });
  };

  $(document).off('click', '.manage-schedule').on('click', '.manage-schedule', function(e){
    e.preventDefault();
    var id = $(this).data('id');
    if (!id) { alert('Purchase id missing'); return; }
    window.openPaymentSchedule(id);
  });

  $(document).off('click', '.transfer-plot').on('click', '.transfer-plot', function(e){
    e.preventDefault();
    var id = $(this).data('id');
    var tab = $(this).data('tab');
    if (!id) { alert('Purchase id missing'); return; }
    if (!tab) { tab = 'name_transfer'; }
    window.openTransferModal(id, tab);
  });

  $(document).off('click', '.manage-refund').on('click', '.manage-refund', function(e){
    e.preventDefault();
    var id = $(this).data('id');
    if (!id) { alert('Purchase id missing'); return; }
    window.openRefundModal(id);
  });

  $(document).off('click', '.merge-purchase').on('click', '.merge-purchase', function(e){
    e.preventDefault();
    var id = $(this).data('id');
    if (!id) { alert('Purchase id missing'); return; }
    if (typeof window.openMergePurchaseModal === 'function') {
      window.openMergePurchaseModal(id);
    } else {
      alert('Merge modal not loaded');
    }
  });

  // Handle pending change badge click
  $(document).off('click', '.pending-change-badge').on('click', '.pending-change-badge', function(e){
    e.preventDefault();
    e.stopPropagation();
    var purchaseId = $(this).data('purchase-id');
    if (!purchaseId) return;

    // Load pending changes for this purchase
    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_pending_changes', {
      purchase_id: purchaseId,
      status: 'pending'
    })
    .done(function(resp){
      var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
      if (data && data.status === 200 && data.changes && data.changes.length > 0) {
        // If only one pending change, open detail modal directly
        if (data.changes.length === 1) {
          var isAdmin = <?php echo (Wo_IsAdmin() || Wo_IsModerator() || check_permission('manage-clients')) ? 'true' : 'false'; ?>;
          if (typeof window.openPendingChangeDetail === 'function') {
            window.openPendingChangeDetail(data.changes[0].id, isAdmin);
          } else {
            alert('Pending change detail modal not loaded');
          }
        } else {
          // Multiple pending changes - show list
          var msg = 'This purchase has ' + data.changes.length + ' pending changes:\n\n';
          data.changes.forEach(function(c, i){
            var typeLabel = c.change_type.replace('_', ' ').toUpperCase();
            msg += (i + 1) + '. ' + typeLabel + ' (Requested: ' + c.request_date + ')\n';
          });
          msg += '\nView details in the Pending Changes tab.';
          alert(msg);
        }
      } else {
        alert('No pending changes found for this purchase');
      }
    })
    .fail(function(){
      alert('Failed to load pending changes');
    });
  });

  // Pass PHP purchase data to JS
  window.clientPurchases = <?php echo json_encode($client_purchases); ?>;

  // Preview Schedule - opens installment excel modal
  $(document).off('click', '.preview-schedule').on('click', '.preview-schedule', function(e){
    e.preventDefault();
    var purchaseId = $(this).data('id');
    if (!purchaseId) {
      alert('Purchase ID not found');
      return;
    }
    
    // Show loading indicator
    var btn = $(this);
    var originalText = btn.html();
    btn.html('<i class="lni lni-spinner lni-spin"></i> Loading...');
    btn.prop('disabled', true);
    
    // Load the modal content via AJAX
    $.ajax({
      url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=installment_excel_modal',
      type: 'POST',
      data: { purchase_id: purchaseId },
      dataType: 'html', // Expect HTML response, not JSON
      success: function(response){
        // Check if response looks like HTML (should start with <!-- or <div)
        if (typeof response === 'string' && (response.trim().startsWith('<') || response.trim().startsWith('<!--'))) {
          // Remove any existing installment modal
          $('#installmentExcelModal').remove();
          // Append the new modal HTML to body
          $('body').append(response);
          // Show the modal
          var modalEl = document.getElementById('installmentExcelModal');
          if (modalEl) {
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
          } else {
            console.error('Modal element not found after append');
            alert('Failed to load modal. Please check console for errors.');
          }
        } else {
          console.error('Invalid response format:', response);
          alert('Error: Server returned invalid response format');
        }
      },
      error: function(xhr, status, error){
        console.error('AJAX error:', status, error);
        console.error('Response:', xhr.responseText);
        alert('Failed to load schedule preview. Error: ' + error);
      },
      complete: function(){
        btn.html(originalText);
        btn.prop('disabled', false);
      }
    });
  });

  // Download Schedule - direct download
  $(document).off('click', '.download-schedule').on('click', '.download-schedule', function(e){
      e.preventDefault();
      var purchaseId = $(this).data('id');
      if (!purchaseId) {
          alert('Purchase ID not found');
          return;
      }

      $.ajax({
          url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=download_schedule',
          type: 'POST',
          data: { purchase_id: purchaseId },
          xhrFields: { responseType: 'blob' },
          success: function(blob, status, xhr) {

              // Try to extract filename from headers
              var filename = "";
              var disposition = xhr.getResponseHeader('Content-Disposition');
              if (disposition && disposition.indexOf('filename=') !== -1) {
                  filename = disposition.split('filename=')[1].replace(/"/g, '');
              } else {
                  filename = 'schedule.pdf';
              }

              // Create temp link to download
              var link = document.createElement('a');
              var url = window.URL.createObjectURL(blob);
              link.href = url;
              link.download = filename;
              document.body.appendChild(link);
              link.click();
              link.remove();
              URL.revokeObjectURL(url);
          },
          error: function() {
              alert('Download failed');
          }
      });
  });
});
</script>

