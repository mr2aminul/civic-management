              <div class="mb-4">
                <h6 class="fw-semibold mb-3">Payment Handling</h6>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" id="merge_combine_payments" checked>
                  <label class="form-check-label" for="merge_combine_payments">
                    <strong>Combine All Payments</strong>
                    <div class="small text-muted">Secondary's paid amount (<span id="merge_secondary_paid_display">0</span>) will be applied to primary's payment schedule</div>
                  </label>
