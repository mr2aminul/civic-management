              <div class="mb-4">
                <h6 class="fw-semibold mb-3">Payment Schedule Handling</h6>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="scheduleHandling" id="merge_schedule_consolidate" value="consolidate" checked>
