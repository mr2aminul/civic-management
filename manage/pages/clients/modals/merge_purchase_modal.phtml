              <div class="mb-4">
                <h6 class="fw-semibold mb-3">Invoice Handling</h6>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="invoiceHandling" id="merge_invoice_consolidate" value="consolidate" checked>
                  <label class="form-check-label" for="merge_invoice_consolidate">
