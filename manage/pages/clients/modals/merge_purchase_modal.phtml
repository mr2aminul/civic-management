<script>
jQuery(function($){
  'use strict';

  var currentStep = 1;
  var mergeData = {};

  function notifySuccess(msg){
    if (typeof pos5_success_noti === 'function') pos5_success_noti(msg);
    else if (typeof toastr !== 'undefined' && toastr.success) toastr.success(msg);
    else alert(msg);
  }
  function notifyError(msg){
    if (typeof pos4_error_noti === 'function') pos4_error_noti(msg);
    else if (typeof toastr !== 'undefined' && toastr.error) toastr.error(msg);
    else alert(msg);
  }

  function goToStep(step) {
    if (step === currentStep) return;

    // Validate current step before moving
    if (currentStep === 1 && step === 2) {
      var secondaryId = $('#merge_secondary_purchase_select').val();
      var reason = $('#merge_reason').val().trim();
      if (!secondaryId) { notifyError('Please select a secondary purchase'); return; }
      if (!reason || reason.length < 5) { notifyError('Please enter a merge reason'); return; }

      mergeData.secondary_purchase_id = secondaryId;
      mergeData.merge_reason = reason;
    }

    // Hide all steps
    $('.merge-step').addClass('d-none');
    $('[data-step="' + step + '"].merge-step').removeClass('d-none');

    // Update step indicator
    $('.step-indicator').removeClass('bg-primary').addClass('bg-light text-dark');
    $('[data-step="' + step + '"].step-indicator').addClass('bg-primary').removeClass('bg-light text-dark');

    // Update buttons
    if (step === 1) {
      $('#merge_prev_step_btn').hide();
      $('#merge_next_step_btn').show();
      $('#merge_submit_btn').hide();
    } else if (step === 2) {
      $('#merge_prev_step_btn').show();
      $('#merge_next_step_btn').show();
      $('#merge_submit_btn').hide();
    } else if (step === 3) {
      $('#merge_prev_step_btn').show();
      $('#merge_next_step_btn').hide();
      $('#merge_submit_btn').show();
      updateReviewStep();
    }

    currentStep = step;
  }

  function updateReviewStep() {
    var primaryInfo = '<strong>Purchase #' + $('#merge_primary_purchase_id').val() + '</strong><br>';
    primaryInfo += $('#merge_primary_project').val() + ', Block ' + $('#merge_primary_block').val() + '<br>';
    primaryInfo += 'Plot ' + $('#merge_primary_plot').val() + ' (' + $('#merge_primary_katha').val() + ' katha)';
    $('#merge_review_primary').html(primaryInfo);

    var secondaryInfo = '<strong>Purchase #' + ($('#mergePurchaseModal').data('secondary-id') || 'N/A') + '</strong><br>';
    secondaryInfo += $('#merge_secondary_project').val() + ', Block ' + $('#merge_secondary_block').val() + '<br>';
    secondaryInfo += 'Plot ' + $('#merge_secondary_plot').val() + ' (' + $('#merge_secondary_katha').val() + ' katha)';
    $('#merge_review_secondary').html(secondaryInfo);

    var primaryPaid = parseFloat($('#mergePurchaseModal').data('primary-paid') || 0);
    var secondaryPaid = parseFloat($('#mergePurchaseModal').data('secondary-paid') || 0);
    var combined = primaryPaid + secondaryPaid;
    $('#merge_review_combined_paid').text('৳' + combined.toLocaleString('en-US', {minimumFractionDigits: 2}));
  }

  // Init Select2 for secondary purchase
  function initMergeSecondarySelect() {
    destroyMergeSecondarySelect();
    var $sel = $('#merge_secondary_purchase_select');
    var primaryId = $('#merge_primary_purchase_id').val();
    
    // Prepare data from local window.clientPurchases
    var data = [];
    if (window.clientPurchases && Array.isArray(window.clientPurchases)) {
        data = window.clientPurchases.filter(function(item) {
            return item.id != primaryId;
        }).map(function(item) {
            return {
                id: item.id,
                text: (item.project || '') + ' - Block ' + (item.block || '') + ', Plot ' + (item.plot || '') + ' (' + (item.katha || '0') + ' katha)',
                raw: {
                    project_name: item.project,
                    block: item.block,
                    plot: item.plot,
                    katha: item.katha,
                    client_name: item.client_name,
                    total_paid: item.total_paid
                }
            };
        });
    }

    $sel.select2({
      dropdownParent: $('#mergePurchaseModal .modal-content'),
      placeholder: 'Select purchase to merge...',
      allowClear: true,
      data: data,
      width: '100%'
    });

    $sel.off('select2:select.mergeSecondarySelected').on('select2:select.mergeSecondarySelected', function(e) {
      var item = e.params && e.params.data ? e.params.data : null;
      if (item && item.raw) {
        var raw = item.raw;
        $('#merge_secondary_project').val(raw.project_name || '');
        $('#merge_secondary_block').val(raw.block || '');
        $('#merge_secondary_plot').val(raw.plot || '');
        $('#merge_secondary_katha').val(raw.katha || '');
        $('#merge_secondary_client').val(raw.client_name || '');
        $('#merge_secondary_details').show();
        $('#mergePurchaseModal').data('secondary-id', item.id).data('secondary-paid', raw.total_paid || 0);
      }
    });

    $sel.off('select2:close.mergeSecondaryClose').on('select2:close.mergeSecondaryClose', function() {
      if (!$(this).val()) {
        $('#merge_secondary_details').hide();
      }
    });
    
    // Auto-select if only one option (meaning client has exactly 2 purchases)
    if (data.length === 1) {
        var singleOption = data[0];
        // We need to wait a tick for Select2 to be ready or just set it directly
        setTimeout(function(){
            $sel.val(singleOption.id).trigger('change');
            // Manually trigger select event logic since trigger('change') might not fire select2:select
            var raw = singleOption.raw;
            $('#merge_secondary_project').val(raw.project_name || '');
            $('#merge_secondary_block').val(raw.block || '');
            $('#merge_secondary_plot').val(raw.plot || '');
            $('#merge_secondary_katha').val(raw.katha || '');
            $('#merge_secondary_client').val(raw.client_name || '');
            $('#merge_secondary_details').show();
            $('#mergePurchaseModal').data('secondary-id', singleOption.id).data('secondary-paid', raw.total_paid || 0);
        }, 100);
    }
  }

  function destroyMergeSecondarySelect() {
    try {
      var $sel = $('#merge_secondary_purchase_select');
      if ($sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
      $sel.empty().append('<option value="">Select purchase to merge...</option>');
    } catch(e) {}
  }

  // Populate modal
  window.populateMergePurchaseModal = function(data, purchaseId) {
    if (!data || !purchaseId) return;

    currentStep = 1;
    mergeData = {};

    $('#merge_primary_purchase_id').val(purchaseId);
    $('#merge_primary_project').val(data.project_name || '');
    $('#merge_primary_block').val(data.current_block || '');
    $('#merge_primary_plot').val(data.current_plot || '');
    $('#merge_primary_katha').val(data.current_katha || '');
    $('#merge_primary_client').val(data.current_name || '');

    $('#mergePurchaseModal').data('primary-paid', data.total_paid || 0).data('secondary-paid', 0);

    $('#merge_secondary_purchase_select').val(null).trigger('change');
    $('#merge_secondary_details').hide();
    $('#merge_reason').val('');
    $('#merge_combine_payments').prop('checked', true);

    goToStep(1);
    initMergeSecondarySelect();
  };

  // Open modal
  window.openMergePurchaseModal = function(purchaseId) {
    if (!purchaseId) { notifyError('Purchase ID missing'); return; }

    $.ajax({
      url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_transfer_data',
      type: 'POST',
      dataType: 'json',
      data: { purchase_id: purchaseId },
      success: function(resp) {
        var data = (typeof resp === 'object') ? resp : (resp ? JSON.parse(resp) : null);
        if (data && (data.status == 200 || data.status === '200')) {
          window.populateMergePurchaseModal(data, purchaseId);
          $('#mergePurchaseModal').modal('show');
        } else {
          notifyError(data && data.message ? data.message : 'Failed to load purchase data');
        }
      },
      error: function() { notifyError('Server error'); }
    });
  };

  // Step navigation
  $(document).off('click', '#merge_next_step_btn').on('click', '#merge_next_step_btn', function() {
    goToStep(currentStep + 1);
  });

  $(document).off('click', '#merge_prev_step_btn').on('click', '#merge_prev_step_btn', function() {
    goToStep(currentStep - 1);
  });

  // Submit merge
  $(document).off('click', '#merge_submit_btn').on('click', '#merge_submit_btn', function() {
    var primaryId = $('#merge_primary_purchase_id').val();
    var secondaryId = $('#merge_secondary_purchase_select').val();
    var reason = $('#merge_reason').val();
    var combinePayments = $('#merge_combine_payments').is(':checked') ? 1 : 0;
    var scheduleHandling = $('input[name="scheduleHandling"]:checked').val();
    var invoiceHandling = $('input[name="invoiceHandling"]:checked').val();
    
    // Get client_id from stored data or window.clientPurchases
    var clientId = 0;
    if (window.clientPurchases && window.clientPurchases.length > 0) {
        clientId = window.clientPurchases[0].client_id;
    }

    $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=request_purchase_merge', {
      client_id: clientId,
      target_purchase_id: primaryId, // Primary is the target (surviving)
      source_purchase_id: secondaryId, // Secondary is the source (merging into target)
      merge_reason: reason,
      merge_paid_amount: combinePayments,
      merge_payment_schedule: (scheduleHandling === 'consolidate' ? 1 : 0),
      merge_invoices: (invoiceHandling === 'consolidate' ? 1 : 0)
    }, function(resp) {
      var data = (typeof resp === 'object') ? resp : (resp ? JSON.parse(resp) : null);
      if (data && (data.status === 200 || data.status === '200')) {
        notifySuccess(data.message || 'Merge request submitted for admin approval!');
        $('#mergePurchaseModal').modal('hide');
        setTimeout(function() { location.reload(); }, 700);
      } else {
        notifyError(data && data.message ? data.message : 'Failed to submit merge request');
      }
    }).fail(function(xhr) {
      notifyError('Server error: ' + (xhr.responseText || 'Unknown'));
    });
  });

  // Cleanup on close
  $('#mergePurchaseModal').on('hidden.bs.modal', function() {
    destroyMergeSecondarySelect();
    currentStep = 1;
    mergeData = {};
  });
});
</script>
