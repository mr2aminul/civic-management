        <!-- Step 3: Review & Approve -->
        <div class="merge-step d-none" data-step="3">
          <div class="card border-0 bg-light mb-4">
            <div class="card-header bg-primary text-white border-0">
              <h6 class="mb-0">Merge Summary</h6>
            </div>
            <div class="card-body">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <h6 class="text-muted small mb-2">PRIMARY PURCHASE</h6>
                  <div id="merge_review_primary" class="bg-white p-3 rounded border">
                    <!-- Populated dynamically -->
                  </div>
                </div>
                <div class="col-md-6">
                  <h6 class="text-muted small mb-2">SECONDARY PURCHASE (TO MERGE)</h6>
                  <div id="merge_review_secondary" class="bg-white p-3 rounded border">
                    <!-- Populated dynamically -->
                  </div>
                </div>
              </div>

              <div class="alert alert-success">
                <h6 class="alert-heading">
                  <i class="lni lni-check-circle me-2"></i>Merge Impact
                </h6>
                <div class="small">
                  <div class="mb-2">
                    <strong>Combined Paid Amount:</strong>
                    <span id="merge_review_combined_paid">৳0.00</span>
                  </div>
                  <div class="mb-2">
                    <strong>Payment Schedule:</strong>
                    <span id="merge_review_schedule_info">Will be consolidated</span>
                  </div>
                  <div>
                    <strong>Status:</strong>
                    <span class="badge bg-warning">Pending Admin Approval</span>
                  </div>
