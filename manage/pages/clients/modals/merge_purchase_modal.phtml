          <i class="lni lni-chevron-left me-1"></i>Back
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="merge_next_step_btn">
          <i class="lni lni-chevron-right me-1"></i>Next
        </button>
        <button type="button" class="btn btn-success" id="merge_submit_btn" style="display:none;">
          <i class="lni lni-check-circle me-1"></i>Submit for Approval
        </button>
