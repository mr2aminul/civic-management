<script>
jQuery(function($){
  'use strict';

  // ---------------- Helpers ----------------
  function safeParse(resp) {
    if (!resp) return null;
    if (typeof resp === 'object') return resp;
    try { return JSON.parse(resp); } catch(e) {
      try { return (new Function('return ' + resp))(); } catch(e2) { return null; }
    }
  }

  function notifySuccess(msg){
    if (typeof pos5_success_noti === 'function') pos5_success_noti(msg);
    else if (typeof toastr !== 'undefined' && toastr.success) toastr.success(msg);
    else alert(msg);
  }
  function notifyError(msg){
    if (typeof pos4_error_noti === 'function') pos4_error_noti(msg);
    else if (typeof toastr !== 'undefined' && toastr.error) toastr.error(msg);
    else alert(msg);
  }

  function normalizePlotItem(item) {
    if (!item) return null;
    var id = item.id || item.purchase_id || '';
    var plot = item.plot || item.plot_number || item.plot_no || '';
    var katha = (item.katha !== undefined) ? String(item.katha) : '';
    var block = item.block || item.block_name || '';
    var road = item.road || item.road_name || '';
    var facing = item.facing || item.facing_side || '';
    var status = (item.status !== undefined) ? item.status : '';
    var statusLabel = item.status_label || getStatusLabel(status);
    var available = (item.available === 1 || item.available === true || String(item.available) === '1');

    var parts = [];
    if (block) parts.push('Block ' + String(block).toUpperCase());
    if (plot) parts.push('Plot ' + String(plot));
    if (katha) parts.push(String(katha) + ' katha');
    if (road) parts.push('Road ' + String(road));
    if (facing) parts.push('Facing ' + String(facing));

    return {
      id: id,
      text: parts.join(' • ') || String(id),
      plot: plot,
      katha: katha,
      block: block,
      road: road,
      facing: facing,
      status: status,
      status_label: statusLabel,
      available: available,
      blocked: !available,
      raw: item
    };
  }

  function getStatusLabel(status) {
    var s = String(status || '').toLowerCase();
    if (s === '0' || s === '1' || s === 'available') return 'Available';
    if (s === '2' || s === 'sold' || s === 'booked') return 'Sold';
    if (s === '3' || s === 'complete') return 'Complete';
    if (s === '4' || s.indexOf('cancel') !== -1) return 'Cancelled';
    return s ? (s.charAt(0).toUpperCase() + s.slice(1)) : '';
  }

  function getBadgeClass(status) {
    var s = String(status || '').toLowerCase();
    if (/(sold|2|booked)/.test(s)) return 'sold';
    if (/(cancel|4)/.test(s)) return 'cancelled';
    if (/(complete|3)/.test(s)) return 'completed';
    if (/(available|0|1)/.test(s)) return 'available';
    return 'other';
  }

  function populateNewPlotDetails(plotData) {
    $('#transfer_new_detail_block').val(plotData.block || plotData.block_name || '');
    $('#transfer_new_detail_plot').val(plotData.plot || plotData.plot_number || '');
    $('#transfer_new_detail_road').val(plotData.road || plotData.road_name || '');
    $('#transfer_new_detail_katha').val(plotData.katha || '');
    $('#transfer_new_detail_facing').val(plotData.facing || '');
  }

  // ---------------- Select2 for transfer_new_plot_select (POST body data) ----------------
  function initTransferPlotSelect2(projectSlug, projectId, excludePurchaseId) {
    destroyTransferPlotSelect2();
    var $sel = $('#transfer_new_plot_select');
    if (!$sel.length) return;

    var slug = projectSlug || '';
    var pid = projectId || '';
    var exclude_id = String(excludePurchaseId || '');

    $sel.select2({
      // attach to modal-content (better than modal or body for positioning)
      dropdownParent: $('#transferModal .modal-content'),
      placeholder: 'Search plots (block/plot/katha/road)...',
      allowClear: true,
      minimumInputLength: 0,
      closeOnSelect: true,
      width: '100%',
      ajax: {
        url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=search_purchases',
        type: 'POST', // send via POST body as requested
        dataType: 'json',
        delay: 250,
        cache: true,
        data: function(params) {
          return {
            q: params.term || '',
            page: params.page || 1,
            per_page: 30,
            project_slug: slug,
            project_id: slug,
            available_only: true,
            exclude_purchase_id: exclude_id
          };
        },
        processResults: function(data, params) {
          try {
            var rows = (data && data.results) ? data.results : (data && data.data ? data.data : (Array.isArray(data) ? data : []));
            var mapped = (rows || []).map(function(it){ return normalizePlotItem(it); })
              .filter(function(it){
                return it && it.available !== false && it.id && String(it.id) !== String(exclude_id);
              });
            var more = !!(data && (data.more || (data.pagination && data.pagination.more)));
            return { results: mapped, pagination: { more: more } };
          } catch(e) {
            console.error('processResults error', e);
            return { results: [], pagination: { more: false } };
          }
        }
      },
      templateResult: function(item) {
        if (!item || !item.id) return item && item.text ? item.text : null;
        var $wrap = $('<div class="select2-result-item d-flex justify-content-between align-items-center"></div>');
        var $label = $('<div class="select2-main-text flex-grow-1"></div>').text(item.text);
        $wrap.append($label);
        if (item.status_label) {
          var cls = getBadgeClass(item.status || '');
          var $badge = $('<span class="select2-result-badge ' + cls + '"></span>').text(item.status_label);
          $wrap.append($badge);
        }
        return $wrap;
      },
      templateSelection: function(item) { return item && item.text ? item.text : null; }
    });

    // autofocus search field when opened
    $sel.off('select2:open.transferAutoFocus').on('select2:open.transferAutoFocus', function() {
      setTimeout(function() {
        var search = document.querySelector('.select2-container--open .select2-search__field');
        if (search) {
          search.focus();
          try { search.setSelectionRange && search.setSelectionRange(search.value.length, search.value.length); } catch(e){}
        }
      }, 20);
    });

    // on select -> populate details and set selected id & new per katha
    $sel.off('select2:select.transferSelected').on('select2:select.transferSelected', function(e) {
      var item = e.params && e.params.data ? e.params.data : null;
      if (item) {
        populateNewPlotDetails(item);
        $('#transfer_new_plot_details').show();
        if (item.raw && item.raw.per_katha !== undefined) {
          $('#transfer_new_per_katha').val(item.raw.per_katha);
        }
        $('#transferModal').data('transfer-selected-plot-id', item.id);
      } else {
        $('#transfer_new_plot_details').hide();
        $('#transferModal').removeData('transfer-selected-plot-id');
      }
    });

    $sel.off('select2:close.transferClose').on('select2:close.transferClose', function() {
      var val = $(this).val();
      if (!val) {
        $('#transfer_new_plot_details').hide();
        $('#transferModal').removeData('transfer-selected-plot-id');
      }
    });
  }

    // ---------------- Select2 for transfer_existing_client_select ----------------
    function initTransferClientSelect2(project_slug, project_id, purchaseId, exclude_client_id) {
      destroyTransferClientSelect2();
      var $sel = $('#transfer_existing_client_select');
      if (!$sel.length) return;
    
      $sel.select2({
        dropdownParent: $('#transferModal .modal-content'),
        placeholder: '-- Create new client or select existing --',
        allowClear: true,
        minimumInputLength: 1,
        width: '100%',
        ajax: {
          url: Wo_Ajax_Requests_File() + '?f=manage_clients&s=search_clients',
          type: 'POST',
          dataType: 'json',
          delay: 250,
          cache: true,
          data: function(params) {
            return {
              q: params.term || '',
              page: params.page || 1,
              per_page: 30,
              project_slug: project_slug || '',
              project_id: project_id || '',
              purchaseId: purchaseId || '',
              exclude_client_id: exclude_client_id || ''
            };
          },
          processResults: function(data, params) {
            try {
              // accept both shapes:
              // 1) { results: [...] } (Select2 standard)
              // 2) { data: [...] } (common)
              // 3) plain array [ {id,text}, ... ]
              var rows = [];
              if (!data) rows = [];
              else if (Array.isArray(data)) rows = data;
              else if (data.results && Array.isArray(data.results)) rows = data.results;
              else if (data.data && Array.isArray(data.data)) rows = data.data;
              else if (data.items && Array.isArray(data.items)) rows = data.items;
              else rows = [];
    
              // map rows into Select2-friendly items, accepting multiple server shapes
              var mapped = rows.map(function(it){
                // if server already returned {id, text}, just keep it
                if (it && it.id !== undefined && it.text !== undefined) {
                  return { id: it.id, text: it.text, raw: it };
                }
                // otherwise build text from name/phone/email
                var name = it.name || it.text || it.full_name || '';
                var phone = it.phone || it.mobile || '';
                var email = it.email || '';
                var txt = name + (phone ? ' (' + phone + ')' : '') + (email && !phone ? ' (' + email + ')' : '');
                return { id: it.id || it.value || null, text: txt || String(it.id || it.value || ''), raw: it };
              });
    
              var more = !!(data && (data.more || (data.pagination && data.pagination.more)));
              return { results: mapped, pagination: { more: more } };
            } catch(e) {
              console.error('processResults error', e);
              return { results: [], pagination: { more: false } };
            }
          }
        },
        templateResult: function(item) {
          if (!item || !item.id) return item && item.text ? item.text : null;
          // item.text is already safe/display-ready (server may include phone)
          return $('<div>').text(item.text);
        },
        templateSelection: function(item) { return item && item.text ? item.text : null; }
      });
    
      // autofocus search field when opened
      $sel.off('select2:open.clientAutoFocus').on('select2:open.clientAutoFocus', function() {
        setTimeout(function() {
          var search = document.querySelector('.select2-container--open .select2-search__field');
          if (search) {
            search.focus();
            try { search.setSelectionRange && search.setSelectionRange(search.value.length, search.value.length); } catch(e){}
          }
        }, 20);
      });
    
      // on select -> store selected client id
      $sel.off('select2:select.clientSelected').on('select2:select.clientSelected', function(e) {
        var item = e.params && e.params.data ? e.params.data : null;
        if (item) $('#transfer_new_client_id').val(item.id);
        else $('#transfer_new_client_id').val('');
      });
    
      $sel.off('select2:close.clientClose').on('select2:close.clientClose', function() {
        var val = $(this).val();
        if (!val) $('#transfer_new_client_id').val('');
      });
    }

    function destroyTransferClientSelect2() {
      try {
        var $sel = $('#transfer_existing_client_select');
        if ($sel && $sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
      } catch(e) {}
    }

  function destroyTransferPlotSelect2() {
    try {
      var $sel = $('#transfer_new_plot_select');
      if ($sel && $sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
    } catch(e) {}
  }

  // Populate modal
  window.populateTransferModal = function(data, purchaseId, activeTab){
    if(!data || !purchaseId) return;

    $('#transfer_purchase_id').val(purchaseId);

    // Name transfer current owner
    $('#transfer_current_name').val(data.current_name || '');
    $('#transfer_current_name').data('total-paid', data.total_paid || 0);
    $('#transfer_current_name').data('client-id', data.client_id || 0);

    // Plot transfer current info
    $('#current_project_plot').val(data.project_name || '');
    $('#current_block_plot').val(data.current_block || '');
    $('#current_plot_plot').val(data.current_plot || '');
    $('#current_katha_plot').val(data.current_katha || '');
    $('#transfer_current_per_katha_plot').val('৳' + parseFloat(data.current_per_katha) || '৳' + 0);
    $('#transfer_current_per_katha_plot').data('total-paid', data.total_paid || 0);
    
    // default the New Rate Per Katha to current per-katha (unless a selected_plot overrides it)
    $('#transfer_new_per_katha').val(data.current_per_katha !== undefined && data.current_per_katha !== null ? parseFloat(data.current_per_katha) : ($('#transfer_current_per_katha_plot').val() || ''));

    // Cancel plot current info
    $('#current_project_cancel').val(data.project_name || '');
    $('#current_block_cancel').val(data.current_block || '');
    $('#current_plot_cancel').val(data.current_plot || '');
    $('#current_katha_cancel').val(data.current_katha || '');
    $('#transfer_current_per_katha_cancel').val(data.current_per_katha || 0);

    // Populate clients select
    var clientSelect = $('#transfer_existing_client_select').empty().append('<option value="">-- Create new client or select existing --</option>');
    if(data.available_clients && Array.isArray(data.available_clients)){
      data.available_clients.forEach(function(c){
        var safeText = $('<div>').text(c.name + ' (' + (c.phone || 'N/A') + ')').html();
        clientSelect.append('<option value="'+c.id+'">'+safeText+'</option>');
      });
    }

    // Store project context for Select2
    var project_slug = data.project_slug || data.project_id || '';
    var project_id = data.project_id || '';
    var client_id = $('#transfer_current_name').data('client-id') || 0;
    
    $('#transferModal').data('transfer-project-slug', project_slug).data('transfer-project-id', project_id);
    initTransferPlotSelect2(project_slug, project_id, purchaseId);
    //init select2 for client
    initTransferClientSelect2(project_slug, project_id, purchaseId, client_id);
  
    // Preselect tab if specified
    if(activeTab){
      $('input[name="transferType"]').prop('checked', false);
      $('input[name="transferType"][id="transfer_'+activeTab+'_radio"]').prop('checked', true).trigger('change');
    }

    // Preselect plot if edit mode
    if(data.selected_plot && data.selected_plot.id){
      var normalized = normalizePlotItem(data.selected_plot);
      if(normalized){
        var $sel = $('#transfer_new_plot_select');
        var newOpt = new Option(normalized.text, normalized.id, true, true);
        $sel.append(newOpt).trigger('change');
        populateNewPlotDetails(normalized);
        $('#transfer_new_plot_details').show();
        if(normalized.raw && normalized.raw.per_katha !== undefined) $('#transfer_new_per_katha').val(normalized.raw.per_katha);
        $('#transferModal').data('transfer-selected-plot-id', normalized.id);
      }
    } else {
      $('#transfer_new_plot_select').val(null).trigger('change');
      $('#transfer_new_plot_details').hide();
      $('#transferModal').removeData('transfer-selected-plot-id');
    }
  };

  // Open modal globally
  window.openTransferModal = function(purchaseId, activeTab){
    if(!purchaseId){ notifyError('Purchase ID missing'); return; }
    $('#transferModal').removeData('transfer-project-slug transfer-project-id transfer-selected-plot-id');
    $('#transfer_new_plot_details').hide();
    $.ajax({
      url: Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_transfer_data',
      type: 'POST',
      dataType: 'json',
      data: { purchase_id: purchaseId },
      success: function(resp){
        var data = safeParse(resp);
        if(data && (data.status == 200 || data.status === '200')){
          window.populateTransferModal(data, purchaseId, activeTab);
          $('#transferModal').modal('show');
        } else {
          notifyError(data.message || 'Failed to load transfer data');
        }
      },
      error: function(){ notifyError('Server error while loading transfer data'); }
    });
  };

  // ---------------- Fee calculators ----------------
  function calculateFee(mode, value, base) {
    if (mode === 'none') return 0;
    if (mode === 'fixed') return parseFloat(value) || 0;
    if (mode === 'percent') return Math.round((base * parseFloat(value)) / 100);
    return 0;
  }

  $('#transfer_name_fee_mode, #transfer_name_fee_value').off('change input').on('change input', function(){
    var mode = $('#transfer_name_fee_mode').val();
    var value = $('#transfer_name_fee_value').val();
    var base = parseFloat($('#transfer_current_name').data('total-paid') || 0);
    var fee = calculateFee(mode, value, base);
    $('#transfer_name_fee_display').val('৳' + fee.toLocaleString('en-US', {minimumFractionDigits: 0}));
  });

  $('#transfer_plot_fee_mode, #transfer_plot_fee_value').off('change input').on('change input', function(){
    var mode = $('#transfer_plot_fee_mode').val();
    var value = $('#transfer_plot_fee_value').val();
    var base = parseFloat($('#transfer_current_name').data('total-paid') || 0);
    var fee = calculateFee(mode, value, base);
    $('#transfer_plot_fee_display').val('৳' + fee.toLocaleString('en-US', {minimumFractionDigits: 0}));
  });

  $('#transfer_cancel_fee_mode, #transfer_cancel_fee_value').off('change input').on('change input', function(){
    var mode = $('#transfer_cancel_fee_mode').val();
    var value = $('#transfer_cancel_fee_value').val();
    // var base = parseFloat($('[data-purchase-id="' + $('#transfer_purchase_id').val() + '"]').data('total-paid') || 0);
    var base = parseFloat($('#transfer_current_name').data('total-paid') || 0);
    var fee = calculateFee(mode, value, base);
    $('#transfer_cancel_fee_display').val('৳' + fee.toLocaleString('en-US', {minimumFractionDigits: 0}));
  });

  // ---------------- Toggle forms ----------------
  $('input[name="transferType"]').off('change').on('change', function(){
    var t = $(this).val();
    $('.transfer-form').addClass('d-none');
    if (t === 'name_transfer') $('#transfer_name_form').removeClass('d-none');
    else if (t === 'plot_transfer') $('#transfer_plot_form').removeClass('d-none');
    else if (t === 'cancel_plot') $('#transfer_cancel_form').removeClass('d-none');
  });

  // ---------------- Submit Transfer ----------------
  $(document).off('click', '#transfer_submit_btn').on('click', '#transfer_submit_btn', function(){
    var purchaseId = $('#transfer_purchase_id').val() || $('#transfer_purchase_id').val();
    if (!purchaseId) { notifyError('Missing purchase id'); return; }
    var type = $('input[name="transferType"]:checked').val();

    if (type === 'name_transfer') {
      var clientId = $('#transfer_new_client_id').val() || $('#transfer_existing_client_select').val() || 0;
      var reason = $('#transfer_name_reason').val();
      var feeMode = $('#transfer_name_fee_mode').val();
      var feeValue = parseFloat($('#transfer_name_fee_value').val()) || 0;
      if (!clientId) { notifyError('Please select client'); return; }
      if (!reason) { notifyError('Please select transfer reason'); return; }

      $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=process_name_transfer', {
        purchase_id: purchaseId, client_id: clientId || 0, reason: reason, fee_mode: feeMode, fee_value: feeValue
      }, function(resp){
        var data = resp;
        if (!data || data.status === undefined) data = safeParse(resp);
        if (data && (data.status === 200 || data.status === '200')) {
          notifySuccess(data.message || 'Name transfer submitted successfully!');
          $('#transferModal').modal('hide');
          setTimeout(function(){ location.reload(); }, 700);
        } else {
          notifyError((data && data.message) ? data.message : 'Failed to submit transfer');
        }
      }).fail(function(xhr){ notifyError('Server error: ' + (xhr.responseText || 'Unknown')); });

    } else if (type === 'plot_transfer') {
      var selectedPlotId = $('#transferModal').data('transfer-selected-plot-id') || $('#transfer_new_plot_select').val();
      var newPerKatha = parseFloat($('#transfer_new_per_katha').val()) || 0;
      var reason = $('#transfer_plot_reason').val();
      var feeMode = $('#transfer_plot_fee_mode').val();
      var feeValue = parseFloat($('#transfer_plot_fee_value').val()) || 0;

      if (!selectedPlotId || !newPerKatha || !reason) { notifyError('Please fill all required fields'); return; }

      $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=process_plot_transfer', {
        purchase_id: purchaseId, new_plot_id: selectedPlotId, new_per_katha: newPerKatha, reason: reason, fee_mode: feeMode, fee_value: feeValue
      }, function(resp){
        var data = resp;
        if (!data || data.status === undefined) data = safeParse(resp);
        if (data && (data.status === 200 || data.status === '200')) {
          notifySuccess(data.message || 'Plot transfer submitted successfully! Payment schedule will be recalculated.');
          $('#transferModal').modal('hide');
          setTimeout(function(){ location.reload(); }, 700);
        } else {
          notifyError((data && data.message) ? data.message : 'Failed to submit transfer');
        }
      }).fail(function(xhr){ notifyError('Server error: ' + (xhr.responseText || 'Unknown')); });

    } else if (type === 'cancel_plot') {
      var reason = $('#transfer_cancel_reason').val().trim();
      var feeMode = $('#transfer_cancel_fee_mode').val();
      var feeValue = parseFloat($('#transfer_cancel_fee_value').val()) || 0;
      var initiateRefund = $('#transfer_initiate_refund').is(':checked') ? 1 : 0;
      if (!reason || reason.length < 3) { notifyError('Please enter a valid cancellation reason (min 3 chars)'); return; }

      $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=process_cancel_plot', {
        purchase_id: purchaseId, reason: reason, fee_mode: feeMode, fee_value: feeValue, initiate_refund: initiateRefund
      }, function(resp){
        var data = resp;
        if (!data || data.status === undefined) data = safeParse(resp);
        if (data && (data.status === 200 || data.status === '200')) {
          notifySuccess(data.message || 'Plot cancellation processed successfully!');
          $('#transferModal').modal('hide');
          setTimeout(function(){ location.reload(); }, 750);
        } else {
          notifyError((data && data.message) ? data.message : 'Failed to cancel plot');
        }
      }, 'json').fail(function(xhr){ notifyError('Server error: ' + (xhr.responseText || 'Unknown')); });
    }
  });

  // Cleanup: destroy select2 on modal close
  $('#transferModal').on('hidden.bs.modal.transferCleanup', function(){
    try { destroyTransferPlotSelect2(); } catch(e){}
    $('#transfer_new_plot_details').hide();
    $(this).removeData('transfer-project-slug transfer-project-id transfer-selected-plot-id');
  });

  // focus first visible input on show
  $('#transferModal').on('shown.bs.modal', function(){
    setTimeout(function(){ $('#transferModal .modal-body input:visible:first').focus(); }, 120);
  });
});
</script>
