<!-- Include Pre-select Logic -->
<?php echo Wo_LoadManagePage('clients/modals/invoice_preselect'); ?>

<script>
jQuery(document).ready(function($){
    var $modal = $('#createInvoiceModal');
    var $clientSel = $('#create_invoice_client_select');
    var $purchaseSel = $('#invoice_purchase_select');
    var currentSuggestion = null;

    // Initialize Select2 for Client Search
    function initClientSelect() {
        $clientSel.select2({
            dropdownParent: $modal,
            placeholder: 'Search Client by Name, Phone or ID...',
            allowClear: true,
            width: '100%',
            ajax: {
                url: Wo_Ajax_Requests_File() + '?f=manage_clients&s=search_clients',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        q: params.term || '',
                        include_purchase: 1
                    };
                },
                processResults: function (data) {
                    var items = [];
                    if(Array.isArray(data)){
                        items = data.map(function(item){
                            return {
                                id: item.id,
                                text: item.text,
                                purchases: item.purchases || []
                            };
                        });
                    }
                    return { results: items };
                },
                cache: true
            },
            minimumInputLength: 1
        });
    }

    // Initialize on modal show
    $modal.on('shown.bs.modal', function(){
        initClientSelect();
    });

    // Handle Client Selection
    $clientSel.on('select2:select', function(e){
        var data = e.params.data;
        var clientId = data.id;
        var purchases = data.purchases || [];

        $('#create_invoice_client_id').val(clientId);
        
        // Populate Purchase Dropdown
        $purchaseSel.empty().append('<option value="">-- Select Purchase --</option>');
        
        if(purchases.length > 0){
            purchases.forEach(function(p){
                var label = (p.file_num ? p.file_num : ('Purchase #' + (p.purchase_id || p.id))) + 
                            (p.project ? ' (' + p.project + ')' : '');
                $purchaseSel.append(new Option(label, p.purchase_id || p.id));
            });
            $purchaseSel.prop('disabled', false);
            
            if(purchases.length === 1){
                $purchaseSel.val(purchases[0].purchase_id || purchases[0].id).trigger('change');
            }
        } else {
            $purchaseSel.append('<option value="">No purchases found</option>').prop('disabled', true);
        }
    });

    $clientSel.on('select2:clear', function(){
        $('#create_invoice_client_id').val('');
        $purchaseSel.empty().append('<option value="">-- Select Client First --</option>').prop('disabled', true);
        resetDynamicSections();
    });

    // Handle Purchase Selection
    $purchaseSel.on('change', function(){
        var pid = $(this).val();
        if(pid){
            loadSummary(pid);
            loadSuggestion(pid);
        } else {
            resetDynamicSections();
        }
    });

    function resetDynamicSections(){
        $('#client_summary_box').hide();
        $('#smart_suggestions_box').hide();
        currentSuggestion = null;
    }

    // Load Summary (exposed globally for invoice_preselect)
    window.loadSummary = function(purchaseId){
        var clientId = $('#create_invoice_client_id').val();
        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=get_invoice_summary', {
            client_id: clientId,
            purchase_id: purchaseId
        }, function(resp){
            if(resp){
                $('#summary_due_amount').text(formatMoney(resp.total_due));
                $('#summary_paid_amount').text(formatMoney(resp.total_paid));
                $('#summary_credits').text(formatMoney(resp.credits));
                $('#client_summary_box').fadeIn();
            }
        }, 'json');
    };

    // Load Suggestion (exposed globally for invoice_preselect)
    window.loadSuggestion = function(purchaseId){
        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=suggest_next_invoice', {
            purchase_id: purchaseId
        }, function(resp){
            if(resp && resp.status == 200 && resp.suggestion){
                currentSuggestion = resp.suggestion;
                
                $('#suggestion_message').text(currentSuggestion.particular || 'Installment');
                $('#suggested_type').text(formatType(currentSuggestion.type));
                $('#suggested_amount_btn').text(formatMoney(currentSuggestion.suggested_amount));
                
                if(currentSuggestion.is_overdue) $('#overdue_badge').show();
                else $('#overdue_badge').hide();
                
                if(currentSuggestion.late_fee > 0) $('#late_fee_badge').show();
                else $('#late_fee_badge').hide();
                
                $('#smart_suggestions_box').fadeIn();
            } else {
                $('#smart_suggestions_box').hide();
            }
        }, 'json');
    };

    // Use Suggestion
    $('#use_suggestion').click(function(){
        if(!currentSuggestion) return;
        
        $('#invoice_type_select').val(currentSuggestion.type === 'booking_money' || currentSuggestion.type === 'down_payment' ? currentSuggestion.type : 'installment');
        $('#invoice_amount').val(Math.round(currentSuggestion.suggested_amount));
        if(currentSuggestion.due_date) $('#invoice_due_date').val(currentSuggestion.due_date);
        $('#invoice_description').val(currentSuggestion.particular);
        
        $('#invoice_amount').trigger('input');
        $('#invoice_amount').addClass('is-valid');
        setTimeout(() => $('#invoice_amount').removeClass('is-valid'), 1000);
    });

    // Payment Logic
    $('#generate_receipt_check').on('change', function(){
        if($(this).is(':checked')){
            $('#payment_details_section').slideDown();
            var invAmt = $('#invoice_amount').val();
            if(invAmt) $('#payment_received_amount').val(invAmt);
        } else {
            $('#payment_details_section').slideUp();
        }
    });

    $('#invoice_amount').on('input', function(){
        if($('#generate_receipt_check').is(':checked')){
            $('#payment_received_amount').val($(this).val());
        }
    });

    // Submit
    $('#btn_create_invoice_submit').click(function(){
        var $btn = $(this);
        var data = {
            client_id: $('#create_invoice_client_id').val(),
            purchase_id: $purchaseSel.val(),
            invoice_type: $('#invoice_type_select').val(),
            amount: $('#invoice_amount').val(),
            invoice_date: $('#invoice_date').val(),
            due_date: $('#invoice_due_date').val(),
            description: $('#invoice_description').val(),
            send_email: $('#send_email_check').is(':checked') ? 1 : 0,
            payment_received: $('#generate_receipt_check').is(':checked') ? 1 : 0,
            payment_amount: $('#payment_received_amount').val(),
            payment_method: $('#payment_method').val()
        };

        if(!data.client_id){ alert('Please select a client.'); return; }
        if(!data.purchase_id){ alert('Please select a purchase.'); return; }
        if(!data.invoice_type){ alert('Please select invoice type.'); return; }
        if(!data.amount || data.amount <= 0){ alert('Please enter a valid amount.'); return; }

        $btn.prop('disabled', true).html('<i class="lni lni-spinner lni-spin me-2"></i>Creating...');

        $.post(Wo_Ajax_Requests_File() + '?f=manage_inventory&s=create_invoice', data, function(resp){
            $btn.prop('disabled', false).html('<i class="lni lni-save me-2"></i>Create Invoice');
            
            if(resp.status == 200){
                $modal.modal('hide');
                if(typeof Wo_ShowAlert === 'function') Wo_ShowAlert('success', resp.message);
                else alert(resp.message);
                if(typeof DataTableRefresh === 'function') DataTableRefresh('invoices_table');
                if($('#managePurchaseModal').hasClass('show')){
                    var activeTab = $('#managePurchaseModal .nav-link.active').attr('id');
                    if(activeTab) $('#'+activeTab).trigger('shown.bs.tab');
                }
            } else {
                alert('Error: ' + (resp.message || 'Unknown error occurred'));
            }
        }, 'json').fail(function(){
            $btn.prop('disabled', false).html('<i class="lni lni-save me-2"></i>Create Invoice');
            alert('Server connection error');
        });
    });

    // Helpers
    function formatMoney(amount){
        return parseFloat(amount || 0).toLocaleString('en-US');
    }
    
    function formatType(type){
        if(!type) return '';
        return type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
    }

    // Smart Calc Button
    $('#smart_calc_btn').click(function(e){
        e.preventDefault();
        var pid = $purchaseSel.val();
        if(pid) loadSuggestion(pid);
        else alert('Please select a purchase first.');
    });
});
</script>